<% content_for :meta_title, "My Packs | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(title: "My Packs", subtitle: "Every weekly pack you have locked in, and how it did.") %>
  </div>

  <% if (accuracy = current_manager.accuracy) %>
    <div class="mb-6 rounded-2xl bg-zinc-950 p-6 text-white" data-pack-accuracy>
      <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Your accuracy</p>
      <p class="mt-2 text-5xl font-extrabold leading-none tracking-[-0.04em]"><%= pack_percent(accuracy) %>%</p>
      <p class="mt-3 text-sm/6 text-zinc-300">
        The forecast managed <strong class="text-white"><%= pack_percent(current_manager.forecast_accuracy) %>%</strong> on the same packs,
        over <%= pluralize(current_manager.marked_entries.count, "finished gameweek") %>.
        Accuracy is your real points as a share of the best five each pack could have given.
      </p>
    </div>
  <% end %>

  <% if @entries.empty? %>
    <div class="rounded-xl border border-zinc-200 px-6 py-10 text-center text-sm text-zinc-500">
      No packs yet. <%= link_to "Open this week's", pack_landing_path, class: "font-bold text-zinc-950 underline underline-offset-2" %>.
    </div>
  <% else %>
    <ol class="divide-y divide-zinc-200 rounded-2xl border border-zinc-200">
      <% @entries.each do |entry| %>
        <% gameweek = entry.weekly_pack.gameweek %>
        <% real = PackRealScore.new(gameweek) %>
        <% forecast = PackScore.new(entry.weekly_pack.pack).forecast %>
        <li data-pack-history>
          <%= link_to weekly_pack_path(gameweek: gameweek.fpl_id), class: "flex items-center gap-4 px-4 py-3 hover:bg-zinc-50" do %>
            <span class="w-14 text-sm font-extrabold text-zinc-950">GW<%= gameweek.fpl_id %></span>
            <span class="min-w-0 flex-1 text-xs text-zinc-500">
              Captain <%= entry.pack_hand.captain&.player&.display_name %>
              · <%= entry.accuracy ? "#{pack_percent(entry.accuracy)}% accurate, the forecast #{pack_percent(entry.forecast_accuracy)}%" : "#{pack_points(entry.expected_points)} expected" %>
            </span>
            <span class="text-right">
              <% if real.started? %>
                <span class="block text-xl font-extrabold tabular-nums"><%= real.for(entry.pack_hand).points %></span>
                <span class="block text-[10px] text-zinc-500 tabular-nums">forecast <%= real.for(forecast).points %><%= " · live" unless real.final? %></span>
              <% else %>
                <span class="block text-xs font-bold text-zinc-500">Kicks off <%= l(gameweek.start_time, format: :short) %></span>
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>

  <%= form_with url: pack_account_path, method: :patch, class: "mt-10 rounded-2xl border border-zinc-200 p-5" do |form| %>
    <%= form.label :nickname, "Name on the leaderboard", class: "block text-xs font-bold uppercase tracking-wider text-zinc-500" %>
    <div class="mt-2 flex gap-2">
      <%= form.text_field :nickname, value: current_manager.nickname, required: true, maxlength: Manager::NICKNAME_LENGTH,
            class: "min-w-0 flex-1 rounded-lg border border-zinc-300 px-3 py-2 text-base" %>
      <%= form.submit "Rename", class: "rounded-lg bg-zinc-950 px-4 py-2 text-sm font-bold text-white cursor-pointer" %>
    </div>
  <% end %>
  <p class="mt-3 text-xs text-zinc-500">
    Signed in as <%= current_manager.email %>.
    <%= button_to "Sign out", pack_sign_out_path, method: :delete, form_class: "inline", class: "underline underline-offset-2 cursor-pointer" %>
  </p>
</div>
