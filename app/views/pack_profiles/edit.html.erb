<% content_for :meta_title, "Your profile | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-group">
    <%= render PageHeadingComponent.new(title: "Your profile", horizons: play_tabs(current: :pack)) do |heading| %>
      <% heading.with_aside { render "packs/play_account" } %>
    <% end %>
  </div>

  <%= render PanelComponent.new(tone: :outline, data: { pack_profile: true }) do %>
    <%= form_with url: pack_profile_path, method: :patch, class: "space-y-5" do %>
      <div class="grid grid-cols-2 gap-3">
        <%= render FieldComponent.new(name: :first_name, label: "First name", value: @user.first_name,
                                      maxlength: User::NAME_LENGTH, autocomplete: "given-name") %>
        <%= render FieldComponent.new(name: :last_name, label: "Last name", value: @user.last_name,
                                      maxlength: User::NAME_LENGTH, autocomplete: "family-name") %>
      </div>
      <p class="-mt-2 text-xs text-body">For our records. Until you choose a username, the leaderboards show your first name and the first letter of your surname.</p>

      <%= render "packs/username_field", user: @user, required: false, submit: false, placeholder: @user.default_username,
            help: "What the leaderboards show. Leave it blank and you'll appear as #{@user.default_username}." %>

      <%= render ButtonComponent.new(label: "Save", variant: :solid, size: :md, type: "submit") %>
    <% end %>
  <% end %>

  <%= render PanelComponent.new(tone: :outline, tag: :dl, class: "mt-group") do %>
    <%= render StatComponent.new(label: "Email", value: tag.span(@user.email, class: "break-all")) do %>
      <p class="mt-2 text-xs text-body">Only used to send your pack link. Never shown.</p>
    <% end %>
  <% end %>
</div>
