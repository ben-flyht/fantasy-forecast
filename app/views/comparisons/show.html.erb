<% reach = Horizon.find(@head_to_head.horizon) %>
<% horizon_words = reach.label(gameweek: @gameweek&.fpl_id) %>
<% content_for :meta_title, "#{comparison_title(@comparison)} FPL #{horizon_words} | Fantasy Forecast" %>
<% content_for :meta_description, "#{comparison_question(@comparison)} #{verdict_line(@head_to_head)} Both graded A to F from price, ownership, form and fixtures." %>
<% content_for :meta_url, "#{ApplicationHelper::BASE_URL}#{comparison_path(pair: @comparison.slug)}" %>

<%# Every pair of players has an address and the pairs are worth crawling. Every group
    of them has an address too, and there are billions: nobody searches for one, and a
    crawler spending its time here is a crawler not reading the pages that do rank.
    Followed, though, because the players and the pairs beside them are worth reaching.
    The card is drawn for two players, so a group has no picture of its own yet. %>
<% if @comparison.group? %>
  <% content_for :meta_robots, "noindex, follow" %>
<% else %>
  <% content_for :meta_image, "#{ApplicationHelper::BASE_URL}#{comparison_path(pair: @comparison.slug, format: :png)}" %>
<% end %>

<%= render PageHeadingComponent.new(
      title: comparison_question(@comparison),
      subtitle: "Both forecast the same way, from the same stored numbers the rankings are read from.",
      updated_at: @forecast_at,
      share: "Share this answer",
      back: back_to("Comparisons", comparisons_path),
      horizons: forecast_horizons(gameweek: @gameweek&.fpl_id, current: @horizon,
                                  urls: { gameweek: comparison_path(pair: @comparison.slug),
                                          upcoming: comparison_path(pair: @comparison.slug, horizon: "upcoming"),
                                          season: comparison_path(pair: @comparison.slug, horizon: "season") })) %>

<%# Two columns at every width, phone included, and the editor in the same layout as
    the answer. A side is its cards and a box beneath them to add another; a card leaves
    by the cross on it. Both sides filled is a page, so every change goes to the page for
    the sides you have now. %>
<div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4"
     data-controller="comparison-builder"
     data-comparison-builder-url-value="<%= comparison_search_path %>"
     data-comparison-builder-committed-value="true">
  <% @head_to_head.sides.each_with_index do |side, index| %>
    <% picked = @head_to_head.pick == side %>
    <div data-comparison-card data-pick="<%= picked %>"
         data-comparison-builder-target="side" data-side="<%= index %>">
      <%# The badge has a row of its own rather than hanging over the card. On a
          phone a card is about 165px wide and the name starts in that same corner,
          so an overhanging badge sat on top of it. An empty row on the other side
          keeps the two cards level. %>
      <div class="mb-1.5 flex h-[18px] items-center">
        <% if picked %>
          <span class="rounded bg-zinc-900 px-1.5 py-0.5 text-[10px] font-bold uppercase leading-none tracking-wider text-white">
            Our pick<%= ", just" if @head_to_head.close? %>
          </span>
        <% end %>
      </div>

      <%# Both sides carry the same ring and padding, the loser's ring merely
          transparent, so the two columns stay aligned to the pixel. %>
      <% ring = "rounded-xl ring-2 #{picked ? 'ring-zinc-900' : 'ring-transparent'}" %>
      <% ring += " p-1.5" unless side.single? %>

      <div class="<%= ring %>">
        <%# What the side is worth altogether, above the players it is made of. A column
            of two cards with no total is two answers where the reader wanted one. %>
        <% unless side.single? %>
          <div class="mb-2 flex items-start justify-between gap-3 rounded-lg bg-zinc-100 px-3 py-2">
            <div>
              <p class="text-2xl font-extrabold leading-none tabular-nums tracking-[-0.03em] text-zinc-950">
                <%= headline_points(side) || "—" %>
              </p>
              <p class="mt-1 text-[11px] leading-tight text-zinc-500">expected points</p>
            </div>
            <% if side.cost %>
              <div class="text-right">
                <p class="text-2xl font-extrabold leading-none tabular-nums tracking-[-0.03em] text-zinc-950">
                  <%= player_price(side.cost) %>
                </p>
                <p class="mt-1 text-[11px] leading-tight text-zinc-500">cost</p>
              </div>
            <% end %>
          </div>
        <% end %>

        <div class="space-y-2">
          <% side.members.each do |member| %>
            <div class="relative" data-comparison-builder-target="chip"
                 data-side="<%= index %>" data-param="<%= member.player.to_param %>">
              <%= render PlayerCompactCardComponent.new(**comparison_card_arguments(member)) %>
              <% if side.size > 1 %>
                <button type="button" data-action="comparison-builder#remove"
                        aria-label="Remove <%= member.player.display_name %>"
                        style="<%= remove_button_style(member.player.team) %>"
                        class="absolute right-2 top-2 z-10 rounded-full p-1 shadow ring-1 ring-black/10 hover:brightness-110 focus:outline-none focus:ring-2 focus:ring-black/30">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
                  </svg>
                </button>
              <% end %>
            </div>
          <% end %>

          <%# Always a box at the foot of a side to put another player on it. %>
          <div class="relative">
            <input type="text"
                   data-comparison-builder-target="input" data-side="<%= index %>"
                   data-action="input->comparison-builder#search keydown->comparison-builder#keydown"
                   autocomplete="off" placeholder="Add a player"
                   aria-label="Add a player to <%= index.zero? ? "the first" : "the second" %> side"
                   class="w-full rounded-xl border border-dashed border-zinc-300 bg-white px-3 py-3 text-sm text-zinc-600 placeholder:text-zinc-400 focus:border-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10">
            <div class="absolute left-0 right-0 top-full z-20 mt-1 max-h-64 overflow-y-auto rounded-lg border border-zinc-200 bg-white shadow-lg"
                 data-comparison-builder-target="results" data-side="<%= index %>" role="listbox" hidden></div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# The cards say who and by how much. The only things left to say are what they
    cannot: that a pick is marginal, that there is no forecast behind it, or that the
    two sides were never a fair question in the first place. %>
<% notes = [ comparison_note(@head_to_head), uneven_note(@head_to_head) ].compact %>
<% notes.each do |note| %>
  <p class="mt-3 text-sm text-zinc-600"><%= note %></p>
<% end %>

<%# The working underneath the answer: every figure we hold on them, so a manager who
    disagrees with the pick can see what it was made from. %>
<% if @stats.any? %>
  <section class="mt-10">
    <h2 class="text-lg font-semibold text-zinc-900">
      Every number we hold on <%= @comparison.group? ? "the two sides" : "the two of them" %>
    </h2>
    <p class="mt-1 text-sm text-zinc-500">
      The figure that favours a side is the one in black. Where a figure is a fact
      rather than a merit, neither is marked.
      <%= "A figure that belongs to one man rather than to a side is written out for each of them, and favours nobody." if @comparison.group? %>
    </p>

    <% @stats.each do |group| %>
      <div class="mt-6">
        <h3 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400"><%= group.title %></h3>
        <dl class="mt-2 divide-y divide-zinc-100">
          <% group.rows.each do |row| %>
            <%# Each figure stands at its own edge, under the card it belongs to,
                rather than both crowding the label in the middle. %>
            <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 py-2.5 sm:gap-6">
              <dd class="text-left text-sm tabular-nums <%= comparison_value_class(row.leader == :left) %>"><%= row.left %></dd>
              <dt class="text-center text-[11px] leading-tight text-zinc-500 sm:text-xs"><%= row.label %></dt>
              <dd class="text-right text-sm tabular-nums <%= comparison_value_class(row.leader == :right) %>"><%= row.right %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  </section>
<% end %>

<section class="mt-10">
  <h2 class="text-lg font-semibold text-zinc-900">
    How we read <%= comparison_title(@comparison).delete_suffix("?") %>
  </h2>
  <p class="mt-2 text-sm text-zinc-600">
    Every player here is forecast the same way: their price and how many managers own them lead,
    weighed against minutes, recent form, expected goals and assists, and who they are playing.
    <%= reach.total? ?
        "Scores over more than one gameweek are totals, so they are read as the week they average to before they are graded." :
        "The score is the points we expect from the coming gameweek alone." %>
    <% if @head_to_head.close? %>
      The gap here is under <%= number_with_precision(@head_to_head.close_enough, precision: 2) %> of a
      point a week, which is smaller than the difference our forecast can honestly claim to see.
      <%= "Two players carry two players' worth of error, so a side of two has to be further ahead than one man would." if @comparison.group? %>
      We still name one, because a manager with two players and one transfer has to pick one of
      them, but it is a lean rather than a verdict.
    <% end %>
  </p>
</section>

<% if @related.any? %>
  <section class="mt-8">
    <h2 class="text-lg font-semibold text-zinc-900">
      Other players worth weighing against <%= @comparison.group? ? "these" : "these two" %>
    </h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      <% @related.each do |pair| %>
        <li>
          <%= link_to comparison_title(pair), comparison_path(pair: pair.slug),
              class: "inline-block rounded-lg border border-zinc-200 px-3 py-1.5 text-sm text-zinc-700 hover:border-zinc-400 hover:text-zinc-950" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
