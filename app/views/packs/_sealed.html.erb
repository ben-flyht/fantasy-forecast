<div class="pack-sealed" role="button" tabindex="0" aria-label="Tear open the pack"
     data-pack-target="sealed"
     data-action="pointerdown->pack#charge pointerup->pack#open keydown.enter->pack#open keydown.space->pack#open click->pack#open">
  <div class="pack-sealed__wrapper">
    <span class="pack-sealed__foil"></span>
    <span class="pack-sealed__top"></span>
  </div>
  <div class="pack-sealed__label">
    <%= render "shared/logo", size: "0.8rem" %>
    <span class="pack-sealed__meta">
      <% if gameweek %>Gameweek <%= gameweek.fpl_id %><br><% end %>
      7 pairs · 1 shiny
    </span>
  </div>
  <span class="pack-sealed__hint">Tap or hold to tear open</span>
</div>
