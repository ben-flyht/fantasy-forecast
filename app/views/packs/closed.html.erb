<% content_for :meta_title, "Pack Closed | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <%= render EmptyStateComponent.new(
        title: "The Gameweek #{@gameweek.fpl_id} pack has closed",
        message: "The deadline has passed. Next week's pack opens once every game this gameweek has been played.") do %>
    <%= link_to "See the leaderboard", pack_leaderboard_path(gameweek: @gameweek.fpl_id), class: "text-link" %>
  <% end %>
</div>
