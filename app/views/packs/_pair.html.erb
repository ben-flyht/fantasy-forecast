<% pair = hand.current_pair %>
<section data-pack-stage="picking" data-controller="pack-pick"
         data-pack-pick-forfeit-value="<%= hand_path(hand.forfeiting) %>">
  <div class="mb-2 flex items-baseline justify-between gap-3">
    <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">
      Pair <%= hand.keeps.size + 1 %> of <%= hand.pack.size %><%= " · wildcard" if pair.wildcard? %>
    </h2>
    <% if pair.shiny? %>
      <p class="pack-shiny-label text-xs font-extrabold uppercase tracking-wide">Shiny · your captain</p>
    <% end %>
  </div>

  <div class="mb-4 flex items-center gap-3" data-pack-clock>
    <div class="pack-clock h-1.5 flex-1 overflow-hidden rounded-full bg-zinc-200">
      <div class="pack-clock__bar h-full w-full rounded-full bg-zinc-950" data-pack-pick-target="bar"></div>
    </div>
    <span class="w-6 text-right text-sm font-extrabold tabular-nums text-zinc-950" data-pack-pick-target="clock">10</span>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:gap-6">
    <% pair.cards.each_with_index do |card, choice| %>
      <%= render PackCardComponent.new(card: card, href: hand_path(hand.keeping(choice)), shiny: pair.shiny?, index: choice) %>
    <% end %>
  </div>

  <p class="mt-4 text-center text-xs text-zinc-500">Tap a card to keep it. Run out of time and the pair is lost.</p>

  <% unless hand.keeps.empty? %>
    <h2 class="mt-10 mb-3 text-[10px] font-bold uppercase tracking-wider text-zinc-400">Your hand</h2>
    <div class="pack-hand">
      <% hand.picks.each_with_index do |card, index| %>
        <% if card %>
          <%= render PackCardComponent.new(card: card, captain: card == hand.captain, size: :small, index: index) %>
        <% else %>
          <%= render "packs/forfeit", index: index %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
