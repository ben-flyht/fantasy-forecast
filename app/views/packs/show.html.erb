<% content_for :meta_title, "Open a Pack | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="mx-auto max-w-xl" data-controller="pack">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(
          title: "Open a Pack",
          subtitle: "Seven pairs from neighbouring places in our rankings. Keep one card from each, name your bench, and see how you did against the forecast.") %>
  </div>

  <% if @hand.keeps.empty? %>
    <%= render "sealed", gameweek: @gameweek %>
  <% end %>

  <% if @hand.picking? %>
    <%= render "pair", hand: @hand, hidden: @hand.keeps.empty? %>
  <% elsif @hand.benching? %>
    <%= render "bench", hand: @hand %>
  <% else %>
    <%= render "score", hand: @hand, score: @score %>
  <% end %>

  <% if @hand.complete? %>
    <div class="mt-10">
      <%= link_to new_pack_path, class: "pack-another" do %>
        <span class="pack-another__pack" aria-hidden="true"></span>
        <span>Open another pack</span>
      <% end %>
    </div>
  <% elsif @hand.keeps.any? %>
    <p class="mt-10 text-xs">
      <%= link_to "Start again with a new pack", new_pack_path, class: "font-medium text-zinc-500 underline underline-offset-2" %>
    </p>
  <% end %>
</div>
