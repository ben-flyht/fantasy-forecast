<% content_for :meta_title, "#{weekly? ? "Beat the Algorithm, Gameweek #{@gameweek.fpl_id}" : 'Practice Pack'} | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(
          title: weekly? ? "Beat the Algorithm: Gameweek #{@gameweek.fpl_id}" : "Practice Pack",
          subtitle: weekly? ? "One pack a week, one go. Keep one player from each pair and lock in your five: they score for real against the five our forecast would pick." : "Practise as much as you like. Keep one player from each pair and see which of your picks the forecast would have made.",
          share: ("Share my pack" if weekly? && @hand.complete?),
          horizons: pack_sections(weekly: weekly?)) %>
  </div>

  <% if @hand.complete? %>
    <%= render "score", hand: @hand, score: @score %>
  <% else %>
    <%= render "pair", hand: @hand %>
  <% end %>

  <p class="mt-10 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium">
    <%= link_to (weekly? ? "Play a practice pack" : "Start a new practice pack"), (weekly? ? practice_pack_path : new_pack_path), class: "text-zinc-500 underline underline-offset-2" %>
    <% if current_manager %>
      <%= button_to "Sign out", pack_sign_out_path, method: :delete, form_class: "inline", class: "text-zinc-500 underline underline-offset-2 cursor-pointer" %>
    <% end %>
  </p>
</div>
