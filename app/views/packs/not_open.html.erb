<% content_for :meta_title, "Play | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-group">
    <%= render PageHeadingComponent.new(title: "Play: Gameweek #{@gameweek.fpl_id}") %>
  </div>
  <%= render EmptyStateComponent.new(
        title: "Not open yet",
        message: "The Gameweek #{@gameweek.fpl_id} pack opens once every Gameweek #{@gameweek.fpl_id - 1} game has been played.",
        data: { pack_not_open: true }) do %>
    <%= link_to "Gameweek #{@gameweek.fpl_id - 1} leaderboard", pack_leaderboard_path(gameweek: @gameweek.fpl_id - 1), class: "text-link" %>
  <% end %>
</div>
