<% if openable %>
  <button type="button" class="w-14 cursor-pointer text-right text-xl font-extrabold tabular-nums text-zinc-950 underline decoration-zinc-300 decoration-2 underline-offset-4 group-hover:decoration-zinc-950"
          aria-haspopup="dialog" aria-label="<%= pluralize(points, 'point') %>, view team" data-pack-points><%= points %></button>
<% else %>
  <span class="w-14 text-right text-xl font-extrabold tabular-nums text-zinc-950" data-pack-points><%= points || "–" %></span>
<% end %>
<% if local_assigns.key?(:accuracy) %>
  <span class="w-16 text-right text-sm font-bold tabular-nums text-zinc-500" data-pack-accuracy><%= accuracy ? "#{accuracy}%" : "–" %></span>
<% end %>
