<% if local_assigns.key?(:accuracy) %>
  <span class="w-16 text-right text-sm font-bold tabular-nums text-muted" data-pack-accuracy><%= accuracy ? "#{accuracy}%" : "–" %></span>
<% end %>
<% if openable %>
  <button type="button" class="w-14 cursor-pointer text-right text-figure tabular-nums text-ink underline decoration-line-strong decoration-2 underline-offset-4 group-hover:decoration-ink"
          aria-haspopup="dialog" aria-label="<%= pluralize(points, 'point') %>, view team" data-pack-points><%= points %></button>
<% else %>
  <span class="w-14 text-right text-figure tabular-nums text-ink" data-pack-points><%= points || "–" %></span>
<% end %>
