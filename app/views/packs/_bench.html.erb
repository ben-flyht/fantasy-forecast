<section class="pack-stage" data-pack-stage="benching" data-pack-target="stage" data-action="click->pack#skip:capture">
  <h2 class="mb-1 text-[10px] font-bold uppercase tracking-wider text-zinc-400">
    Bench <%= hand.bench.size + 1 %> of <%= PackHand::BENCH_SIZE %>
  </h2>
  <p class="mb-4 text-sm text-zinc-600">
    Five start: the keeper and four outfield, with at least one defender, midfielder and forward.
    Tap a card to put him on the bench. The first on comes on first.
  </p>

  <div class="grid grid-cols-3 gap-3 sm:grid-cols-4">
    <% hand.kept.each_with_index do |card, index| %>
      <% next if hand.bench.include?(index) %>
      <% if hand.benchable?(index) %>
        <div data-pack-choice>
          <%= render PackCardComponent.new(card: card, href: hand_path(hand.benching(index)), captain: card == hand.captain, index: index, verb: "Bench") %>
        </div>
      <% else %>
        <div class="opacity-50 saturate-50" inert>
          <%= render PackCardComponent.new(card: card, captain: card == hand.captain, index: index) %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if hand.substitutes.any? %>
    <h2 class="mt-8 mb-3 text-[10px] font-bold uppercase tracking-wider text-zinc-400">On the bench</h2>
    <div class="pack-hand" inert>
      <% hand.substitutes.each_with_index do |card, index| %>
        <%= render PackCardComponent.new(card: card, size: :small, index: index + 2) %>
      <% end %>
    </div>
  <% end %>
</section>
