<% best = score.perfect %>
<% forecast = score.forecast %>
<% percent = pack_percent(score.share(hand)) %>
<section class="pack-stage" data-pack-stage="scored" data-pack-target="stage"
         data-pack-deal-ms-value="2000" data-action="click->pack#skip:capture">
  <div class="pack-score-panel mb-8 rounded-2xl bg-zinc-950 p-6 text-white">
    <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Your pack</h2>
    <p class="pack-score mt-2 text-6xl font-extrabold leading-none tracking-[-0.04em]"
       data-pack-share data-pack-target="score" data-pack-score="<%= percent %>"><%= percent %>%</p>
    <p class="mt-3 text-sm/6 text-zinc-300">
      <%= percent >= 100 ? "A perfect pack. " : "" %>of the best team this pack allowed.
      You <strong class="tabular-nums text-white"><%= pack_points(score.points(hand)) %></strong>,
      the forecast <strong class="tabular-nums text-white"><%= pack_points(score.points(forecast)) %></strong>,
      the perfect pack <strong class="tabular-nums text-white"><%= pack_points(score.points(best)) %></strong> expected points.
    </p>
  </div>

  <h2 class="mb-3 text-[10px] font-bold uppercase tracking-wider text-zinc-400">Your five</h2>
  <div class="grid grid-cols-3 gap-3 sm:grid-cols-5">
    <% hand.kept.each_with_index do |card, index| %>
      <%= render PackCardComponent.new(card: card, revealed: true, captain: card == hand.captain, index: index) %>
    <% end %>
  </div>

  <h2 class="mt-10 mb-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400">Pair by pair</h2>
  <table class="w-full text-sm">
    <thead>
      <tr class="text-[10px] uppercase tracking-wider text-zinc-400 font-bold text-left">
        <th class="pb-2">You kept</th>
        <th class="pb-2">The forecast kept</th>
      </tr>
    </thead>
    <tbody>
      <% hand.kept.zip(forecast.kept).each do |mine, theirs| %>
        <tr class="border-t border-zinc-200 <%= 'text-zinc-400' if mine == theirs %>" data-pack-pair>
          <td class="py-2"><%= mine.player.display_name %> <span class="tabular-nums text-zinc-500"><%= pack_card_points(mine.expected_points) %></span></td>
          <td class="py-2"><%= theirs.player.display_name %> <span class="tabular-nums text-zinc-500"><%= pack_card_points(theirs.expected_points) %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="mt-6 text-xs/6 text-zinc-500">
    Expected points for the gameweek: all five count, and the captain counts twice.
  </p>
</section>
