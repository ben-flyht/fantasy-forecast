<section data-pack-stage="scored">
  <% if weekly? %>
    <% if @entry && @real %>
      <% row = @board.rows.find { |candidate| candidate.entry == @entry } %>
      <div class="mb-8 rounded-2xl bg-zinc-950 p-6 text-white" data-pack-verdict>
        <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">
          Gameweek <%= @gameweek.fpl_id %>, <%= @gameweek.is_finished ? "final" : "live" %>
        </h2>
        <p class="mt-2 text-5xl font-extrabold leading-none tracking-[-0.04em] tabular-nums">
          <%= pluralize(row.points, "point") %>
        </p>
        <p class="mt-3 text-sm/6 text-zinc-300">
          <%= pack_place(row.place) %> of <%= @board.rows.size %> on the leaderboard<%= " so far. Points update through the gameweek" unless @gameweek.is_finished %>.
          Your captain counts twice.
          <%= link_to "See the leaderboard", pack_leaderboard_path(gameweek: @gameweek.fpl_id), class: "font-bold text-white underline underline-offset-2" %>
        </p>
      </div>
    <% else %>
      <%= render "packs/lock_in", hand: hand %>
    <% end %>
  <% end %>

  <h2 class="mb-3 text-[10px] font-bold uppercase tracking-wider text-zinc-400">Your five</h2>
  <div class="pack-reveal grid grid-cols-3 gap-3 sm:grid-cols-5">
    <% hand.kept.each_with_index do |card, index| %>
      <div>
        <%= render PackCardComponent.new(card: card, captain: card == hand.captain, index: index) %>
        <% if @real %>
          <p class="mt-1.5 text-center text-xs font-bold tabular-nums text-zinc-700" data-pack-card-points>
            <%= pluralize(@real.of(card) * (card == hand.captain ? 2 : 1), "pt") %>
          </p>
        <% end %>
      </div>
    <% end %>
  </div>

  <% unless weekly? %>
    <p class="mt-8 rounded-2xl border-2 border-zinc-950 p-5 text-sm/6 text-zinc-700" data-pack-practice-done>
      <strong class="text-zinc-950">That's your practice five.</strong>
      For real, open the Pack of the Week: one go each gameweek, scored on real points against everyone else.
      <%= link_to "Play this week's pack", pack_landing_path, class: "font-bold text-zinc-950 underline underline-offset-2" %>
    </p>
  <% end %>
</section>
