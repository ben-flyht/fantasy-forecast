<% forecast = score.forecast %>
<% agreed = score.agreements(hand) %>
<section data-pack-stage="scored">
  <div class="mb-8 rounded-2xl bg-zinc-950 p-6 text-white" data-pack-verdict>
    <% if @real %>
      <% mine = @real.for(hand) %>
      <% theirs = @real.for(forecast) %>
      <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Gameweek <%= @gameweek.fpl_id %>, real points</h2>
      <p class="mt-2 text-5xl font-extrabold leading-none tracking-[-0.04em] tabular-nums">
        <%= mine %> <span class="text-2xl text-zinc-400">v <%= theirs %></span>
      </p>
      <p class="mt-3 text-sm/6 text-zinc-300">
        <%= mine > theirs ? "You beat the forecast." : mine == theirs ? "Level with the forecast." : "The forecast won this one." %>
        Your captain counts twice.
      </p>
    <% else %>
      <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">You and the forecast</h2>
      <p class="mt-2 text-5xl font-extrabold leading-none tracking-[-0.04em] tabular-nums"><%= agreed %> of <%= hand.pack.size %></p>
      <p class="mt-3 text-sm/6 text-zinc-300">
        <% if agreed == hand.pack.size %>
          You picked the same five as the forecast.
        <% else %>
          You agreed with the forecast on <%= pluralize(agreed, "pair") %> and went your own way on <%= hand.pack.size - agreed %>.
        <% end %>
        <%= @weekly ? "Real points decide who was right once Gameweek #{@gameweek.fpl_id} is played." : "In this week's pack, real points decide who was right." %>
      </p>
    <% end %>
  </div>

  <h2 class="mb-3 text-[10px] font-bold uppercase tracking-wider text-zinc-400">Your five</h2>
  <div class="pack-reveal grid grid-cols-3 gap-3 sm:grid-cols-5">
    <% hand.kept.each_with_index do |card, index| %>
      <%= render PackCardComponent.new(card: card, captain: card == hand.captain, index: index) %>
    <% end %>
  </div>

  <h2 class="mt-10 mb-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400">Pair by pair</h2>
  <table class="w-full text-sm">
    <thead>
      <tr class="text-[10px] uppercase tracking-wider text-zinc-400 font-bold text-left">
        <th class="pb-2">You kept</th>
        <th class="pb-2">The forecast kept</th>
      </tr>
    </thead>
    <tbody>
      <% hand.kept.zip(forecast.kept).each do |mine, theirs| %>
        <tr class="border-t border-zinc-200 <%= 'text-zinc-400' if mine == theirs %>" data-pack-pair>
          <td class="py-2"><%= mine.player.display_name %><% if @real %> <span class="tabular-nums text-zinc-500"><%= pluralize(@real.of(mine), "pt") %></span><% end %></td>
          <td class="py-2"><%= theirs.player.display_name %><% if @real %> <span class="tabular-nums text-zinc-500"><%= pluralize(@real.of(theirs), "pt") %></span><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
