<section data-pack-stage="scored">
  <% if @board && @real %>
    <% row = @board.row_for(@selection) %>
    <%= render CalloutComponent.new(
          eyebrow: "Gameweek #{@gameweek.fpl_id}, #{@gameweek.is_finished ? 'final' : 'live'}",
          title: pluralize(row.points, "point"), tone: :dark, class: "mb-section", data: { pack_verdict: true }) do %>
      <p>
        <%= row.place&.ordinalize %> of <%= @board.rows.size %> on the leaderboard<%= " so far. Points update through the gameweek" unless @gameweek.is_finished %>.
        Your captain counts twice.
        <%= link_to "See the leaderboard", pack_leaderboard_path(gameweek: @gameweek.fpl_id), class: "text-link text-white" %>
      </p>
    <% end %>
  <% end %>

  <h2 class="eyebrow mb-3">Your five</h2>
  <div class="pack-reveal grid grid-cols-3 gap-3 sm:grid-cols-5">
    <% hand.picks.each_with_index do |card, index| %>
      <div>
        <% if card %>
          <%= render PackCardComponent.new(card: card, captain: card == hand.captain, index: index) %>
          <% if @real %>
            <p class="mt-1.5 text-center text-xs font-bold tabular-nums text-body" data-pack-card-points>
              <%= pluralize(@real.of(card) * (card == hand.captain ? 2 : 1), "pt") %>
            </p>
          <% end %>
        <% else %>
          <%= render "packs/forfeit", index: index %>
        <% end %>
      </div>
    <% end %>
  </div>

</section>
