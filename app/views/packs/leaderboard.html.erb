<% content_for :meta_title, "Play: Gameweek #{@gameweek.fpl_id} Leaderboard | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-group">
    <%= render PageHeadingComponent.new(
          title: "Leaderboard: Gameweek #{@gameweek.fpl_id}",
          subtitle: "Everyone opened their own pack. Real FPL points for each five, with the captain counting twice.",
          horizons: play_tabs(current: :weekly, gameweek: @gameweek)) do |heading| %>
      <% heading.with_aside { render "packs/play_account" } %>
    <% end %>
  </div>

  <%= render "packs/leaderboard_steps", gameweek: @gameweek %>

  <% if @board.rows.empty? %>
    <%= render EmptyStateComponent.new(message: "Nobody has locked in a pack yet.") %>
  <% else %>
    <% status = @gameweek.is_finished ? "final points" : @gameweek.started? ? "live points" : "ranked once the games start" %>
    <div data-controller="leaderboard-hand">
      <%= render LeaderboardComponent.new(caption: "#{pluralize(@board.rows.size, 'player')} · #{status}",
                                          columns: [ %w[Accuracy w-16], %w[Points w-14] ]) do |board| %>
        <% leaderboard_top(@board.rows).each_with_index do |row, index| %>
          <% mine = current_user && row.user == current_user %>
          <% board.with_row(place: row.place&.ordinalize, name: row.user.leaderboard_name, pro: pros.include?(row.user),
                            mine: mine, gap: leaderboard_gap?(row, index),
                            class: ("cursor-pointer #{'hover:bg-surface-subtle' unless mine}" if @real),
                            data: { pack_row: true, action: ("click->leaderboard-hand#open" if @real),
                                    pack_row_name: "#{row.place&.ordinalize} #{row.user.leaderboard_name}",
                                    pack_row_summary: ("#{pluralize(row.points.to_i, 'point')} · #{row.accuracy}% accuracy" if @real) }) do |entry| %>
            <% entry.with_figures do %>
              <%= render "packs/leaderboard_scores", points: row.points, accuracy: row.accuracy, openable: @real.present? %>
            <% end %>
            <% if @real %>
              <%= render "packs/leaderboard_hand", hand: row.selection.pack_hand, real: @real %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= render "packs/hand_dialog" %>
    </div>
  <% end %>
</div>
