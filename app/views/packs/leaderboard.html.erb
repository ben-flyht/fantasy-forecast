<% content_for :meta_title, "Pack of the Week Leaderboard, Gameweek #{@gameweek.fpl_id} | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(
          title: "Leaderboard: Gameweek #{@gameweek.fpl_id}",
          subtitle: "Everyone opened their own pack. Real FPL points for each five, with the captain counting twice.",
          horizons: play_tabs(current: :weekly, gameweek: @gameweek)) %>
  </div>

  <%= render "packs/leaderboard_steps", gameweek: @gameweek %>

  <% if @board.rows.empty? %>
    <div class="rounded-xl border border-zinc-200 px-6 py-10 text-center text-sm text-zinc-500">Nobody has locked in a pack yet.</div>
  <% else %>
    <p class="mb-3 text-[10px] font-bold uppercase tracking-wider text-zinc-400">
      <%= pluralize(@board.rows.size, "player") %> ·
      <%= @gameweek.is_finished ? "final points" : @gameweek.started? ? "live points" : "ranked once the games start" %>
    </p>
    <%= render "packs/leaderboard_columns" %>
    <div data-controller="leaderboard-hand">
    <ol class="divide-y divide-zinc-200 rounded-2xl border border-zinc-200">
      <% @board.rows.each do |row| %>
        <% mine = current_user && row.user == current_user %>
        <li class="group px-4 py-3 <%= 'bg-zinc-100' if mine %> <%= 'cursor-pointer hover:bg-zinc-50' if @real %>" <%= tag.attributes(data: { action: "click->leaderboard-hand#open" }) if @real %> data-pack-row
            data-pack-row-name="<%= row.place&.ordinalize %> <%= row.user.leaderboard_name %>"
            data-pack-row-summary="<%= "#{pluralize(row.points.to_i, 'point')} · #{row.accuracy}% accuracy" if @real %>">
          <div class="flex w-full items-center gap-4">
            <span class="w-10 text-right text-lg font-extrabold tabular-nums text-zinc-950"><%= row.place&.ordinalize || "–" %></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-bold text-zinc-950"><%= row.user.leaderboard_name %><%= " (you)" if mine %></span>
              <% if (captain = row.selection.pack_hand.captain) %>
                <span class="block truncate text-xs text-zinc-500">Captain <%= captain.player.display_name %></span>
              <% end %>
            </span>
            <%= render "packs/leaderboard_scores", points: row.points, accuracy: row.accuracy, openable: @real.present? %>
          </div>
          <% if @real %>
            <%= render "packs/leaderboard_hand", hand: row.selection.pack_hand, real: @real %>
          <% end %>
        </li>
      <% end %>
    </ol>
    <%= render "packs/hand_dialog" %>
    </div>
  <% end %>

  <p class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium">
    <%= link_to "Play this week's pack", pack_landing_path, class: "text-zinc-950 underline underline-offset-2" %>
  </p>
</div>
