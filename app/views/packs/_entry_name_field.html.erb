<%= label_tag :entry_name, "Entry name", class: "block text-xs font-bold uppercase tracking-wider text-zinc-800" %>
<div class="mt-1 flex flex-col gap-3 sm:flex-row">
  <%= text_field_tag :entry_name, user.entry_name, required: true, maxlength: User::ENTRY_NAME_LENGTH, autocomplete: "nickname",
        placeholder: "e.g. Haaland's Hairband", aria: { describedby: "entry-name-help" },
        class: "block w-full min-w-0 flex-1 rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-base" %>
  <%= submit_tag "Save", class: "shrink-0 rounded-xl bg-zinc-950 px-5 py-3 text-sm font-extrabold uppercase text-white cursor-pointer" %>
</div>
<% if user.errors[:entry_name].any? %>
  <p class="mt-2 text-sm text-red-700" data-pack-entry-name-error>Entry name <%= user.errors[:entry_name].to_sentence %>.</p>
<% end %>
<p id="entry-name-help" class="mt-2 text-xs text-zinc-600">This is what the leaderboards show. Up to <%= User::ENTRY_NAME_LENGTH %> characters, and you can change it any time on your profile.</p>
