<% chosen = hand.choice_at(index) %>
<div id="pack_pair_<%= index %>" data-controller="pack-pair" data-pack-pair>
  <div class="grid grid-cols-2 gap-4 sm:gap-6">
    <% pair.cards.each_with_index do |card, choice| %>
      <% state = ("kept" if chosen == choice) || ("passed" unless chosen.nil?) %>
      <div class="pack-choice <%= "pack-choice--#{state}" if state %>" data-pack-choice="<%= state %>" data-pack-pair-target="choice" data-action="click->pack-pair#choose">
        <%= render PackCardComponent.new(card: card, method: :post, shiny: pair.shiny?, captain: pair.shiny? && state == "kept",
              href: weekly_pack_picks_path(gameweek: gameweek.fpl_id, pair: index, keep: PackHand::LETTERS[choice]),
              index: (index * 2) + choice) %>
      </div>
    <% end %>
  </div>
</div>
