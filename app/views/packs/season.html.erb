<% content_for :meta_title, "Play: Season #{@accuracy ? 'Accuracy' : 'Points'} | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-group">
    <%= render PageHeadingComponent.new(
          title: @accuracy ? "Leaderboard: Season accuracy" : "Leaderboard: Season points",
          subtitle: (@accuracy ? "Accuracy is the share of the points on offer you scored: keep the better card of every pair and it's 100%. Rating blends your average with everyone's, as if you'd started the season with two average weeks, so one lucky week can't top a season of good calls. The same weeks and average always give the same rating." : "Points are your best single gameweek this season."),
          horizons: play_tabs(current: @accuracy ? :accuracy : :points)) do |heading| %>
      <% heading.with_aside { render "packs/play_account" } %>
    <% end %>
  </div>


  <% if @board.rows.empty? %>
    <%= render EmptyStateComponent.new(message: "No gameweek has been played yet.") %>
  <% elsif @accuracy %>
    <%= render "packs/season_accuracy", rows: @board.accuracy_rows %>
  <% else %>
    <div data-controller="leaderboard-hand">
      <%= render LeaderboardComponent.new(caption: pluralize(@board.rows.size, "player"), columns: [ %w[Points w-14] ]) do |board| %>
        <% leaderboard_top(@board.rows).each_with_index do |row, index| %>
          <% mine = current_user && row.user == current_user %>
          <% board.with_row(place: row.place.ordinalize, name: row.user.leaderboard_name, pro: row.pro?,
                            mine: mine, gap: leaderboard_gap?(row, index),
                            class: "cursor-pointer #{'hover:bg-surface-subtle' unless mine}",
                            data: { pack_row: true, pack_season_row: true, action: "click->leaderboard-hand#open",
                                    pack_row_name: "#{row.place.ordinalize} #{row.user.leaderboard_name}",
                                    pack_row_summary: "Best week, Gameweek #{row.best.selection.gameweek.fpl_id} · #{pluralize(row.points, 'point')}" }) do |entry| %>
            <% entry.with_figures do %>
              <%= render "packs/leaderboard_scores", points: row.points, openable: true %>
            <% end %>
            <%= render "packs/leaderboard_hand", hand: row.best.selection.pack_hand, real: row.real %>
          <% end %>
        <% end %>
      <% end %>
      <%= render "packs/hand_dialog" %>
    </div>
  <% end %>
</div>
