<% if current_user %>
  <div class="flex items-center gap-4 text-sm font-medium" data-play-account>
    <% on_profile = current_page?(pack_profile_path) %>
    <%= link_to "Profile", pack_profile_path, "aria-current": ("page" if on_profile),
          class: on_profile ? "text-zinc-950 underline decoration-2 underline-offset-4" : "text-zinc-500 hover:text-zinc-950" %>
    <%= button_to "Sign out", pack_sign_out_path, method: :delete, form_class: "inline",
          class: "text-zinc-500 hover:text-zinc-950 cursor-pointer" %>
  </div>
<% end %>
