<%= render PanelComponent.new(tone: :strong, tag: :p, id: "pack_status", class: "mb-group text-copy text-body",
                              data: { pack_status: true }) do %>
  <% if hand.complete? %>
    <strong class="text-ink">That's your five.</strong>
  <% else %>
    <strong class="text-ink"><%= hand.kept.size %> of <%= hand.pack.size %> picked.</strong>
  <% end %>
  Tap a card to keep it. You can change any pick until the deadline,
  <strong class="text-ink"><%= gameweek.start_time.in_time_zone("London").strftime("%a %-d %b, %H:%M") %></strong>.
<% end %>
