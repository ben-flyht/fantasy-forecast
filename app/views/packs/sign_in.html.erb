<% content_for :meta_title, "Pack of the Week | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(
          title: "Pack of the Week",
          subtitle: "Every gameweek you get your own pack of five pairs. Keep one player from each pair and climb the leaderboard on real FPL points.",
          horizons: play_tabs(current: :pack)) %>
  </div>

  <div class="flex justify-center pt-2">
    <%= render "packs/sealed_pack", gameweek: @gameweek %>
  </div>

  <%= form_with url: pack_sign_ins_path, class: "relative z-10 -mt-60 rounded-2xl border border-white/70 bg-white/75 p-6 shadow-2xl shadow-zinc-950/20 backdrop-blur-[3px]", data: { turbo: false } do |form| %>
    <h2 class="mb-4 text-lg font-extrabold tracking-tight text-zinc-950">
      <%= @gameweek ? "Your Gameweek #{@gameweek.fpl_id} pack is waiting" : "Your pack is waiting" %>
    </h2>
    <% if @user&.errors&.any? %>
      <p class="mb-4 rounded-lg bg-red-400/20 px-4 py-3 text-sm text-red-700"><%= @user.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="space-y-4">
      <div>
        <%= form.label :email, "Your email", class: "block text-xs font-bold uppercase tracking-wider text-zinc-800" %>
        <%= form.email_field :email, value: @user&.email, required: true, autocomplete: "email",
              class: "mt-1 block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-base" %>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= form.label :first_name, "First name", class: "block text-xs font-bold uppercase tracking-wider text-zinc-800" %>
          <%= form.text_field :first_name, value: @user&.first_name, maxlength: User::NAME_LENGTH, autocomplete: "given-name",
                class: "mt-1 block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-base" %>
        </div>
        <div>
          <%= form.label :last_name, "Last name", class: "block text-xs font-bold uppercase tracking-wider text-zinc-800" %>
          <%= form.text_field :last_name, value: @user&.last_name, maxlength: User::NAME_LENGTH, autocomplete: "family-name",
                class: "mt-1 block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-base" %>
        </div>
      </div>
      <p class="text-xs text-zinc-700">Your name is only needed the first time. The leaderboard shows your first name and last initial.</p>
    </div>
    <%= form.submit "Email me my pack", class: "mt-5 rounded-xl bg-zinc-950 px-5 py-3 text-sm font-extrabold uppercase text-white cursor-pointer" %>
    <p class="mt-4 text-xs/5 text-zinc-700">
      We email you a link that opens your pack and keeps you signed in on that device. No password. Your email is only used for your pack and is never shown.
    </p>
  <% end %>

  <ul class="mt-8 space-y-2 text-sm/6 text-zinc-700">
    <li><strong class="text-zinc-950">One pack a week.</strong> Keep one player from each pair, and change your mind as often as you like until the FPL deadline.</li>
    <li><strong class="text-zinc-950">Scored for real.</strong> Come back while the games are on and we'll show your points and your place on the leaderboard as they happen.</li>
  </ul>
</div>
