<% content_for :meta_title, "Pack of the Week | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(
          title: "Pack of the Week",
          subtitle: "A weekly test of your FPL judgement. Pick the better player from each of five pairs, scored on real FPL points. Prove you call it right, week after week, and your picks help shape our player rankings.",
          horizons: play_tabs(current: :pack)) %>
  </div>

  <div class="relative overflow-x-clip pt-20">
  <div class="pointer-events-none absolute right-6 top-0 rotate-[14deg] sm:right-12" aria-hidden="true">
    <%= render "packs/sealed_pack", gameweek: @gameweek, small: true %>
  </div>

  <%= form_with url: pack_sign_ins_path, class: "relative z-10 rounded-2xl border border-white/70 bg-white/75 p-6 shadow-2xl shadow-zinc-950/20 backdrop-blur-[3px]", data: { turbo: false } do |form| %>
    <h2 class="mb-4 text-lg font-extrabold tracking-tight text-zinc-950">
      <%= @gameweek ? "Your Gameweek #{@gameweek.fpl_id} pack is waiting" : "Your pack is waiting" %>
    </h2>
    <% if @user&.errors&.any? %>
      <p class="mb-4 rounded-lg bg-red-400/20 px-4 py-3 text-sm text-red-700"><%= @user.errors.full_messages.to_sentence %></p>
    <% end %>
    <%= form.label :email, "Your email", class: "block text-xs font-bold uppercase tracking-wider text-zinc-800" %>
    <div class="mt-1 flex flex-col gap-3 sm:flex-row">
      <%= form.email_field :email, value: @user&.email, required: true, autocomplete: "email",
            class: "block w-full min-w-0 flex-1 rounded-lg border border-zinc-300 bg-white px-3 py-2.5 text-base" %>
      <%= form.submit "Email me my pack", class: "shrink-0 rounded-xl bg-zinc-950 px-5 py-3 text-sm font-extrabold uppercase text-white cursor-pointer" %>
    </div>
    <p class="mt-4 text-xs/5 text-zinc-700">
      We email you a link that opens your pack and keeps you signed in on that device. No password. Your email is only used for your pack and is never shown.
    </p>
  <% end %>
  </div>

  <ul class="mt-8 space-y-2 text-sm/6 text-zinc-700">
    <li><strong class="text-zinc-950">One pack a week.</strong> Five pairs of players. Keep one from each, and change your mind as often as you like until the FPL deadline.</li>
    <li><strong class="text-zinc-950">Scored for real.</strong> Your five score their real FPL points, with your captain counting twice. Watch your place on the leaderboard as the games are played.</li>
    <li><strong class="text-zinc-950">Prove you know your stuff.</strong> Accuracy is how much of the points on offer you score. Keep it high across the season and you become a Pro, and Pros' picks feed into the Fantasy Forecast player rankings.</li>
  </ul>
</div>
