<section data-pack-stage="picking" <%= tag.attributes(data: { controller: "pack-open" }) if @dealing %>>
  <% if @dealing %>
    <div class="flex flex-col items-center gap-8 py-6" data-pack-opener>
      <%= render "packs/sealed_pack", gameweek: @gameweek %>
      <button type="button" class="rounded-xl bg-zinc-950 px-8 py-3.5 text-sm font-extrabold uppercase tracking-wide text-white cursor-pointer disabled:opacity-60"
              data-pack-open-target="button" data-action="pack-open#open">Open pack</button>
    </div>
  <% end %>
  <div <%= tag.attributes(hidden: @dealing, data: { pack_open_target: ("board" if @dealing) }) %>>
  <p class="mb-6 rounded-2xl border-2 border-zinc-950 p-5 text-sm/6 text-zinc-700" data-pack-status>
    <% if hand.complete? %>
      <strong class="text-zinc-950">That's your five.</strong>
    <% else %>
      <strong class="text-zinc-950"><%= hand.kept.size %> of <%= hand.pack.size %> picked.</strong>
    <% end %>
    Tap a card to keep it. You can change any pick until the deadline,
    <strong class="text-zinc-950"><%= @gameweek.start_time.in_time_zone("London").strftime("%a %-d %b, %H:%M") %></strong>.
  </p>

  <div class="space-y-8" <%= tag.attributes(data: { pack_open_target: ("deck" if @dealing) }) %>>
    <% hand.pack.pairs.each_with_index do |pair, index| %>
      <% chosen = hand.choice_at(index) %>
      <div data-controller="pack-pair" data-pack-pair>
        <div class="grid grid-cols-2 gap-4 sm:gap-6">
          <% pair.cards.each_with_index do |card, choice| %>
            <% state = ("kept" if chosen == choice) || ("passed" unless chosen.nil?) %>
            <div class="pack-choice <%= "pack-choice--#{state}" if state %>" data-pack-choice="<%= state %>" data-pack-pair-target="choice" data-action="click->pack-pair#choose">
              <%= render PackCardComponent.new(card: card, method: :post, shiny: pair.shiny?, captain: pair.shiny? && state == "kept",
                    href: weekly_pack_picks_path(gameweek: @gameweek.fpl_id, pair: index, keep: PackHand::LETTERS[choice]),
                    index: (index * 2) + choice) %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  </div>
</section>
