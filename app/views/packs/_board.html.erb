<section data-pack-stage="picking" <%= tag.attributes(data: { controller: "pack-open" }) if @dealing %>>
  <% if @dealing %>
    <div class="flex flex-col items-center gap-8 py-6" data-pack-opener>
      <%= render "packs/sealed_pack", gameweek: @gameweek %>
      <button type="button" class="rounded-xl bg-zinc-950 px-8 py-3.5 text-sm font-extrabold uppercase tracking-wide text-white cursor-pointer disabled:opacity-60"
              data-pack-open-target="button" data-action="pack-open#open">Open pack</button>
    </div>
  <% end %>
  <div <%= tag.attributes(hidden: @dealing, data: { pack_open_target: ("board" if @dealing) }) %>>
  <%= render "packs/pick_status", hand: hand, gameweek: @gameweek %>

  <div class="space-y-8" <%= tag.attributes(data: { pack_open_target: ("deck" if @dealing) }) %>>
    <% hand.pack.pairs.each_with_index do |pair, index| %>
      <%= render "packs/pick_pair", pair: pair, index: index, hand: hand, gameweek: @gameweek %>
    <% end %>
  </div>
  </div>
</section>
