<% if @entry %>
  <p class="mb-8 rounded-2xl border-2 border-zinc-950 p-5 text-sm/6 text-zinc-700" data-pack-locked>
    <strong class="text-zinc-950">Locked in.</strong> This is your one pack for Gameweek <%= @gameweek.fpl_id %>.
    <%= @real ? "Your score updates as the games are played." : "Come back once the games start and we'll show your score as the gameweek goes on." %>
  </p>
<% elsif current_manager && !@weekly_pack.locked? %>
  <div class="mb-8 rounded-2xl border-2 border-zinc-950 p-5" data-pack-lock>
    <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">One pack a week, one go</h2>
    <p class="mt-2 text-sm/6 text-zinc-700">
      Lock these five in to play the algorithm for real. You get one pack each gameweek, and once it's locked it can't change.
    </p>
    <%= button_to "Lock in my five", weekly_pack_entry_path(gameweek: @gameweek.fpl_id), params: { hand: hand.code },
          class: "mt-4 rounded-xl bg-zinc-950 px-5 py-3 text-sm font-extrabold uppercase text-white cursor-pointer",
          form: { data: { turbo: false } } %>
    <p class="mt-3 text-xs">
      <%= link_to "Pick again", weekly_pack_path(gameweek: @gameweek.fpl_id), class: "text-zinc-500 underline underline-offset-2" %>
    </p>
  </div>
<% end %>
