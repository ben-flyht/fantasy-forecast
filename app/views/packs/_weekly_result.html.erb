<% if @entry %>
  <% if @real.started? %>
    <% mine = @real.for(hand) %>
    <% theirs = @real.for(score.forecast) %>
    <div class="mb-8 rounded-2xl border-2 border-zinc-950 p-5" data-pack-real>
      <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">
        Real points, <%= @real.final? ? "final" : "live" %>
      </h2>
      <p class="mt-2 text-4xl font-extrabold leading-none tracking-[-0.03em] tabular-nums">
        <%= mine.points %> <span class="text-base font-bold text-zinc-500">v the forecast <%= theirs.points %></span>
      </p>
      <% mine.substitutions.each do |absent, incoming| %>
        <p class="mt-2 text-xs text-zinc-600"><%= incoming.player.display_name %> came on for <%= absent.player.display_name %>.</p>
      <% end %>
      <p class="mt-3 text-sm">
        <%= link_to "See the leaderboard", pack_leaderboard_path(gameweek: @gameweek.fpl_id), class: "font-bold underline underline-offset-2" %>
      </p>
    </div>
  <% else %>
    <div class="mb-8 rounded-2xl border-2 border-zinc-950 p-5">
      <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Locked in</h2>
      <p class="mt-2 text-sm/6 text-zinc-700">
        Your five score for real from <%= l(@gameweek.start_time, format: :short) %>. Come back once the games start
        to watch it live against everyone else and the forecast. Substitutes come on automatically once the gameweek is finished.
      </p>
      <p class="mt-3 text-sm">
        <%= link_to "See who else is in", pack_leaderboard_path(gameweek: @gameweek.fpl_id), class: "font-bold underline underline-offset-2" %>
      </p>
    </div>
  <% end %>
<% else %>
  <div class="mb-8 rounded-2xl border-2 border-zinc-950 p-5" data-pack-lock>
    <h2 class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Happy with it?</h2>
    <p class="mt-2 text-sm/6 text-zinc-700">
      Lock it in to score real points this gameweek and go on the leaderboard. There is one pack each week, and once it is locked it cannot change.
    </p>
    <%= button_to "Lock in my team", weekly_pack_entry_path(gameweek: @gameweek.fpl_id),
          params: { hand: hand.code }, class: "pack-another mt-4 cursor-pointer", form: { data: { turbo: false } } %>
    <p class="mt-3 text-xs">
      <%= link_to "Start again", weekly_pack_path(gameweek: @gameweek.fpl_id), class: "text-zinc-500 underline underline-offset-2" %>
    </p>
  </div>
<% end %>
