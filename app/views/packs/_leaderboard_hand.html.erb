<div class="mt-3 grid grid-cols-5 gap-2" data-pack-row-hand>
  <% hand.picks.zip(hand.discards).each_with_index do |(kept, discarded), index| %>
    <div class="flex flex-col gap-1.5 sm:gap-0">
      <div class="relative z-10 flex flex-col" data-pack-row-kept>
        <% if kept %>
          <%= render PackCardComponent.new(card: kept, captain: kept == hand.captain, size: :small, index: index) %>
          <p class="mt-1 text-center text-xs font-bold tabular-nums text-zinc-950 sm:order-first sm:mt-0 sm:mb-1" data-pack-card-points>
            <%= pluralize(real.of(kept) * (kept == hand.captain ? 2 : 1), "pt") %>
          </p>
        <% else %>
          <%= render "packs/forfeit", index: index %>
        <% end %>
      </div>
      <% discarded.each.with_index(1) do |card, depth| %>
        <div class="relative opacity-50 grayscale <%= kept ? 'sm:-mt-[88%]' : 'sm:mt-1.5' %>"
             style="z-index: <%= 10 - depth %>;" data-pack-row-discarded>
          <%= render PackCardComponent.new(card: card, size: :small, index: index) %>
          <p class="mt-1 text-center text-xs font-medium tabular-nums text-zinc-500" data-pack-card-points>
            <%= pluralize(real.of(card), "pt") %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
