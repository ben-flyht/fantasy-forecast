<%= render PanelComponent.new(tone: :strong, class: "mb-section", data: { pack_username_prompt: true }) do %>
  <%= form_with url: pack_profile_path, method: :patch do %>
    <h2 class="mb-3 text-subheading text-ink">Pick a username for the leaderboards</h2>
    <%= hidden_field_tag :from, "pack" %>
    <%= render "packs/username_field", user: current_user %>
  <% end %>
<% end %>
