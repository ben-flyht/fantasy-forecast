<%= render LeaderboardComponent.new(caption: pluralize(rows.size, "player"),
                                    columns: [ %w[Weeks w-11], %w[Avg w-12], %w[Rating w-14] ]) do |board| %>
  <% leaderboard_top(rows).each_with_index do |row, index| %>
    <% board.with_row(place: row.place.ordinalize, name: row.user.leaderboard_name, pro: row.pro?,
                      mine: current_user && row.user == current_user, gap: leaderboard_gap?(row, index),
                      data: { pack_accuracy_row: true }) do |entry| %>
      <% entry.with_figures do %>
        <span class="w-11 text-right text-sm font-bold tabular-nums text-muted" data-pack-weeks><%= row.weeks %></span>
        <span class="w-12 text-right text-sm font-bold tabular-nums text-muted" data-pack-average><%= row.accuracy || 0 %>%</span>
        <span class="w-14 text-right text-figure tabular-nums text-ink" data-pack-rating><%= row.rating %></span>
      <% end %>
    <% end %>
  <% end %>
<% end %>
