<%= render FieldComponent.new(
      name: :username, label: "Username", value: user.username,
      required: local_assigns.fetch(:required, true), maxlength: User::USERNAME_LENGTH, autocomplete: "nickname",
      placeholder: local_assigns.fetch(:placeholder, "e.g. Haaland's Hairband"),
      error: ("Username #{user.errors[:username].to_sentence}." if user.errors[:username].any?),
      help: local_assigns.fetch(:help, "This is what the leaderboards show. Up to #{User::USERNAME_LENGTH} characters, and you can change it any time on your profile.")) do |field| %>
  <% if local_assigns.fetch(:submit, true) %>
    <% field.with_action { render ButtonComponent.new(label: "Save", variant: :solid, size: :md, type: "submit", class: "shrink-0") } %>
  <% end %>
<% end %>
