<% document_title = "Best FPL Squad #{@horizon == 'season' ? 'for the Rest of Season' : "GW#{@gameweek&.fpl_id}"} | Fantasy Forecast" %>
<% content_for :meta_title, document_title %>
<% content_for :meta_description, "The best Fantasy Premier League squad £100.0m can buy for #{horizon_label.downcase}, picked from our own forecasts. Eleven starters, four substitutes, and the captain to take." %>
<% content_for :meta_url, "#{ApplicationHelper::BASE_URL}#{squad_url}" %>
<% content_for :meta_image, "#{ApplicationHelper::BASE_URL}#{squad_url(format: :png)}" if @squad %>
<% content_for :meta_image_height, ShareCard::SQUARE if @squad %>

<div class="mb-group">
  <%= render PageHeadingComponent.new(
        title: "The Best £100.0m Squad, #{horizon_label}",
        subtitle: "The squad to build from scratch, if you were starting today.",
        updated_at: @forecast_at,
        share: ("Share this squad" if @squad),
        back: back_home,
        horizons: forecast_horizons(gameweek: @gameweek&.fpl_id, current: @horizon,
                                    urls: { gameweek: squad_path, upcoming: upcoming_squad_path,
                                            season: season_squad_path })) %>
</div>

<% if @squad %>
  <p class="mb-group text-xs text-muted">Sharing sends the whole team as a picture, not just a link.</p>
<% end %>

<% if @squad %>
  <div class="mb-group">
    <%= render StatStripComponent.new(stats: [
          [ "Formation", @squad.formation ],
          [ "Expected points", @squad.expected_points.round ],
          [ "Spent", player_price(@squad.cost) ],
          [ "In the bank", player_price(@squad.banked) ]
        ]) %>
  </div>

  <%# The armband was already drawn as a (C) beside a name, which is an answer only
      if you were looking at the picture. It is the question most people arrive with,
      so it is worth a sentence of its own. %>
  <% if (captain_pick = @squad.captain) && (captain_player = @players[captain_pick["player_id"]]) %>
    <%= render CalloutComponent.new(eyebrow: "Who to captain, #{horizon_label.downcase}", title: captain_player.display_name,
                                    url: player_path(captain_player), class: "mb-section") do %>
      <p>
        <%= captain_player.team&.name %>, and the highest forecast in the squad on
        <%= format("%.1f", captain_pick["expected_points"].to_f) %> expected points. The armband doubles
        whatever he scores, so it belongs on the player expected to score most.
        <%= link_to "See every captain option in the game", captain_path, class: "text-link" %>.
      </p>
    <% end %>
  <% end %>

  <%= render "picks", title: "Starting XI",
             picks: %w[goalkeeper defender midfielder forward].flat_map { |position| @squad.starters_in(position) } %>

  <div class="mt-section">
    <%= render "picks", title: "Bench", picks: @squad.bench %>
  </div>

  <div class="mt-section space-y-2 text-xs/6 text-muted">
    <p>
      Picked to FPL's own rules: fifteen players, two keepers, five defenders, five
      midfielders, three forwards, no more than three from any one club, and
      <%= player_price(SquadOptimiser::BUDGET) %> to spend.
    </p>
    <p>
      A substitute only scores when a starter does not play, so the eleven are weighed in
      full and the bench by how often each place is actually used. Players FPL has flagged
      as anything other than fully available are left out.
    </p>
    <p>
      Expected points count the captain twice, as FPL scores him, so the number is what the
      team would be expected to return rather than what its players are forecast on their own.
    </p>
    <p>
      This is the squad to build from scratch rather than a set of transfers: it knows
      nothing about the team you already own.
    </p>
  </div>

  <%= render FaqComponent.new(title: "FPL Squad FAQ", pairs: [
        [ "What is the best FPL squad right now?",
          "A #{@squad.formation} on #{@squad.expected_points.round} expected points for #{horizon_label.downcase}, counting the captain twice as FPL does, spending #{player_price(@squad.cost)} of the #{player_price(SquadOptimiser::BUDGET)} budget and leaving #{player_price(@squad.banked)} in the bank. The fifteen are listed above, with the starting eleven and the bench in the order FPL itself uses." ],
        [ "How is the squad picked?",
          "By searching for the fifteen players with the highest total forecast that FPL's own rules allow: two goalkeepers, five defenders, five midfielders, three forwards, no more than three from any one club, and #{player_price(SquadOptimiser::BUDGET)} to spend. A substitute only scores when a starter does not play, so the eleven are weighed in full and the bench by how often each place is actually used." ],
        [ "Is this the squad I should own?",
          "That is a question about the team you already own, and this squad knows nothing about it. What it tells you is what a perfect #{player_price(SquadOptimiser::BUDGET)} team looks like #{horizon_label.downcase}: the further your own team is from it, the more there is to gain by moving towards it." ],
        [ "Who should I captain?",
          @squad.captain && @players[@squad.captain["player_id"]] ?
            "#{@players[@squad.captain['player_id']].display_name}, the highest forecast in the squad on #{format('%.1f', @squad.captain['expected_points'].to_f)} expected points. The armband doubles whatever he scores, so it belongs on the player expected to score most." :
            "The armband belongs on the highest forecast in your starting eleven, because it doubles whatever he scores." ],
        [ "Is this squad picked for one week or to keep?",
          "To keep: it is the squad worth owning for #{horizon_label.downcase}. A team picked for one gameweek and thrown away would chase that week's fixtures much harder than this does." ]
      ]) %>
<% else %>
  <%= render EmptyStateComponent.new(
        title: "No squad yet",
        message: "There is no forecast for #{horizon_label.downcase} to build one from.") %>
<% end %>
