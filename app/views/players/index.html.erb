<%# Named once, used twice: the head needs it on a full render, and the frame needs it
    again on every swap, because Turbo will not touch the title on a frame visit. %>
<% document_title = "Best FPL #{@position_filter&.capitalize}s #{horizon_short} | Fantasy Forecast" %>
<% content_for :meta_title, document_title %>
<% content_for :meta_description, "FPL #{@position_filter} rankings for #{horizon_label}. Every player graded, led by price and ownership and weighed against form, fixtures, and expected goals to help you win at Fantasy Premier League." %>
<% content_for :meta_url, @canonical_path ? "#{ApplicationHelper::BASE_URL}#{@canonical_path}" : root_url %>
<% content_for :meta_image, "#{ApplicationHelper::BASE_URL}#{@card_path}" %>

<%# Every link inside advances the address bar. The horizon and the positions are
    links now, and a link inside a frame swaps the frame without touching the URL
    unless it is told to: without this, choosing Rest of Season showed the season
    but left you standing at the gameweek's address. %>
<%= turbo_frame_tag "rankings_container", data: { turbo_action: "advance" } do %>
    <%# The horizon comes out of the filter bar below and into the heading, so it is
        the same control in the same place as every other page reads its forecast at. %>
    <div class="mb-6" data-controller="page-title" data-page-title-text-value="<%= document_title %>">
      <%= render PageHeadingComponent.new(
            title: @page_title,
            subtitle: "Check the forecast before you pick your team.",
            updated_at: @forecast_at,
            share: "Share these rankings",
            back: back_home,
            horizons: forecast_horizons(gameweek: @gameweek, season: season?,
                                        gameweek_url: horizon_url(:gameweek),
                                        season_url: horizon_url(:season))) %>
    </div>

    <%# Each filter on its own line on a phone, one row from sm up: position first,
        because it is the one that changes what you are looking at, then the team,
        then the price pushed to the far end where a range belongs. %>
    <%# Each filter on its own line on a phone. From sm up they share a row with the
        space divided between them: position at one end, price at the other, team
        standing in the middle rather than crowding the positions. %>
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <%# The positions are the same control as the horizon above, and links for the
          same reason: /gameweeks/1/goalkeepers is a page people arrive on from a
          search, so it deserves an href rather than a radio button. %>
      <%= render SegmentedControlComponent.new(label: "Position", options: position_options) %>

      <%= form_with url: rankings_path, method: :get, data: { turbo_frame: "rankings_container", turbo_action: "advance", controller: "filter-navigation", action: "submit->filter-navigation#submit" }, id: "filters-form", class: "contents" do |f| %>
        <%# The horizon and the position are links now, so the form carries them as
            hidden fields instead. Without them the filters submit no gameweek at all
            and ask for /gameweeks/null/goalkeepers. %>
        <%= hidden_field_tag :gameweek, horizon_param, id: nil %>
        <%= hidden_field_tag :position, @position_filter, id: nil %>

        <div class="flex items-center gap-2">
          <span class="shrink-0 text-sm text-zinc-500">Team</span>
          <%= render DropdownComponent.new(
            label: "Team",
            name: "team_id",
            options: [['All', '']] + @available_teams.map { |t| [t.name, t.id] },
            selected: @team_filter
          ) %>
        </div>

        <%= render "players/price_filter" %>
      <% end %>
    </div>

    <!-- Rankings Table -->
    <% if @consensus_rankings.any? %>
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full min-w-[720px] table-fixed border-separate border-spacing-y-2 text-zinc-950">
          <thead>
            <tr class="text-[10px] uppercase tracking-wider text-zinc-400 font-bold">
              <th class="w-[104px] pb-2 text-center">Rank</th>
              <th class="pb-2 pl-10 text-left">Player</th>
              <th class="w-[104px] pb-2 text-center">Grade</th>
            </tr>
          </thead>
          <tbody>
            <% @consensus_rankings.each do |ranking| %>
              <% player = @players_by_id[ranking.player_id] %>
              <%= render PlayerRowComponent.new(ranking: ranking, player: player, facts: @row_facts&.dig(player.id)) %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="md:hidden flex flex-col gap-2">
        <% @consensus_rankings.each do |ranking| %>
          <% player = @players_by_id[ranking.player_id] %>
          <%= render PlayerCardComponent.new(ranking: ranking, player: player, facts: @row_facts&.dig(player.id)) %>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-8 text-center">
        <div class="text-zinc-500">
          <svg class="mx-auto h-12 w-12 text-zinc-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
            <path d="M34 40h10v-4a6 6 0 00-10.712-3.714M34 40H14m20 0v-4a9.971 9.971 0 00-.712-3.714M14 40H4v-4a6 6 0 0110.713-3.714M14 40v-4c0-1.313.253-2.566.713-3.714m0 0A9.971 9.971 0 0124 24c4.004 0 7.625 2.31 9.287 5.286" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-zinc-900">No rankings yet</h3>
          <p class="mt-1 text-sm text-zinc-500">
            No ranking data available for <%= horizon_label.downcase %><%= " (#{@position_filter.capitalize}s)" if @position_filter.present? %>.
          </p>
        </div>
      </div>
    <% end %>

    <%= render "players/seo_content" %>
<% end %>
