<%# Named once, used twice: the head needs it on a full render, and the frame needs it
    again on every swap, because Turbo will not touch the title on a frame visit. %>
<% document_title = "Best FPL #{@position_filter&.capitalize}s #{horizon_short} | Fantasy Forecast" %>
<% content_for :meta_title, document_title %>
<% content_for :meta_description, "FPL #{@position_filter} rankings for #{horizon_label}. Every player graded, led by price and ownership and weighed against form, fixtures, and expected goals to help you win at Fantasy Premier League." %>
<% content_for :meta_url, @canonical_path ? "#{ApplicationHelper::BASE_URL}#{@canonical_path}" : root_url %>
<% content_for :meta_image, "#{ApplicationHelper::BASE_URL}#{@card_path}" %>

<%# Every link inside advances the address bar. The horizon and the positions are
    links now, and a link inside a frame swaps the frame without touching the URL
    unless it is told to: without this, choosing Rest of Season showed the season
    but left you standing at the gameweek's address. %>
<%= turbo_frame_tag "rankings_container", data: { turbo_action: "advance" } do %>
    <%# The horizon comes out of the filter bar below and into the heading, so it is
        the same control in the same place as every other page reads its forecast at. %>
    <div class="mb-group" data-controller="page-title" data-page-title-text-value="<%= document_title %>">
      <%= render PageHeadingComponent.new(
            title: @page_title,
            subtitle: "Check the forecast before you pick your team.",
            updated_at: @forecast_at,
            share: "Share these rankings",
            back: back_home,
            horizons: forecast_horizons(gameweek: @gameweek, current: @horizon,
                                        urls: { gameweek: horizon_url(:gameweek),
                                                upcoming: horizon_url(:upcoming),
                                                season: horizon_url(:season) })) %>
    </div>

    <%# Each filter on its own line until there is room for all three across. Position
        (the control that changes what you are looking at) first, then the team, then the
        price pushed to the far end where a range belongs. Position, team and a 160px
        slider with its label need the best part of eight hundred pixels between them, so
        they share a row only from lg up — below that they would crowd and clip. %>
    <div class="mb-group flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between lg:gap-4">
      <%# The positions are the same control as the horizon above, and links for the
          same reason: /gameweeks/1/goalkeepers is a page people arrive on from a
          search, so it deserves an href rather than a radio button. %>
      <%= render SegmentedControlComponent.new(label: "Position", options: position_options, event: "horizon_switch") %>

      <%= form_with url: position_rankings_path(horizon_param, @position_filter), method: :get, data: { turbo_frame: "rankings_container", turbo_action: "advance", controller: "filter-navigation", action: "submit->filter-navigation#submit" }, id: "filters-form", class: "contents" do |f| %>
        <div class="flex items-center gap-2">
          <span class="shrink-0 text-sm text-muted">Team</span>
          <%= render DropdownComponent.new(
            label: "Team",
            name: "team_id",
            options: [['All', '']] + @available_teams.map { |t| [t.name, t.id] },
            selected: @team_filter
          ) %>
        </div>

        <%= render PriceSliderComponent.new(filter: @price_filter) %>
      <% end %>
    </div>

    <!-- Rankings Table -->
    <% if @consensus_rankings.any? %>
      <%= render PlayerListComponent.new(entries: @consensus_rankings.map { |ranking|
            { ranking: ranking, player: @players_by_id[ranking.player_id], facts: @row_facts&.dig(ranking.player_id) }
          }) %>
    <% else %>
      <%= render EmptyStateComponent.new(
            title: "No rankings yet",
            message: "No ranking data available for #{horizon_label.downcase}#{" (#{@position_filter.capitalize}s)" if @position_filter.present?}.") %>
    <% end %>

    <%= render "players/seo_content" %>
<% end %>
