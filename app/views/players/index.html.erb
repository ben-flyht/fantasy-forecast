<% content_for :meta_title, "Best FPL #{@position_filter&.capitalize}s #{horizon_short} | Fantasy Forecast" %>
<% content_for :meta_description, "FPL #{@position_filter} rankings for #{horizon_label}. Player picks graded A to F, led by price and ownership and weighed against form, fixtures, and expected goals to help you win at Fantasy Premier League." %>
<% content_for :meta_url, @canonical_path ? "#{ApplicationHelper::BASE_URL}#{@canonical_path}" : root_url %>

<%= turbo_frame_tag "rankings_container" do %>
    <div class="mb-6">
      <h1 class="text-xl sm:text-2xl font-semibold text-zinc-900"><%= @page_title %></h1>
      <p class="mt-1 text-sm text-zinc-500">What the market backs, checked against form, fixtures, and expected goals — graded A to F.</p>
      <% if @forecast_at %>
        <p class="mt-1 text-xs text-zinc-400">
          Updated
          <time datetime="<%= @forecast_at.iso8601 %>" title="<%= l @forecast_at, format: :long %>"><%= time_ago_in_words(@forecast_at) %> ago</time>
        </p>
      <% end %>
    </div>

    <div class="flex flex-wrap items-center gap-4 mb-6">
      <%= form_with url: root_path, method: :get, data: { turbo_frame: "rankings_container", turbo_action: "advance", controller: "filter-navigation", action: "submit->filter-navigation#submit" }, id: "filters-form", class: "contents" do |f| %>
        <!-- Horizon Selector -->
        <div class="flex items-center gap-2">
          <span class="text-sm text-zinc-500">Show</span>
          <%= render DropdownComponent.new(
            label: "Horizon",
            name: "gameweek",
            options: @horizon_options,
            selected: horizon_param
          ) %>
        </div>

        <!-- Team Selector -->
        <div class="flex items-center gap-2">
          <span class="text-sm text-zinc-500">Team</span>
          <%= render DropdownComponent.new(
            label: "Team",
            name: "team_id",
            options: [['All', '']] + @available_teams.map { |t| [t.name, t.id] },
            selected: @team_filter
          ) %>
        </div>

        <!-- Position Filter -->
        <div class="flex items-center gap-1" role="radiogroup">
          <% @available_positions.each do |position| %>
            <% position_config = FantasyForecast::POSITION_CONFIG[position] %>
            <% is_active = @position_filter == position %>
            <label class="px-3 py-1.5 text-sm font-medium rounded-lg cursor-pointer transition-colors <%= is_active ? 'bg-zinc-900 text-white' : 'text-zinc-500 hover:text-zinc-900' %>">
              <%= radio_button_tag :position, position, is_active,
                  class: "sr-only",
                  onchange: "this.form.requestSubmit()" %><%= position_config[:display_name] %>
            </label>
          <% end %>
        </div>
      <% end %>

    </div>

    <!-- Rankings Table -->
    <% if @consensus_rankings.any? %>
      <div class="hidden md:block overflow-x-auto">
        <table class="w-full min-w-[720px] table-fixed border-separate border-spacing-y-2 text-zinc-950">
          <thead>
            <tr class="text-[10px] uppercase tracking-wider text-zinc-400 font-bold">
              <th class="w-[104px] pb-2 text-center">Rank</th>
              <th class="pb-2 pl-10 text-left">Player</th>
              <th class="w-[104px] pb-2 text-center">Grade</th>
            </tr>
          </thead>
          <tbody>
            <% @consensus_rankings.each do |ranking| %>
              <% player = @players_by_id[ranking.player_id] %>
              <%= render PlayerRowComponent.new(ranking: ranking, player: player, facts: @row_facts&.dig(player.id)) %>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="md:hidden flex flex-col gap-2">
        <% @consensus_rankings.each do |ranking| %>
          <% player = @players_by_id[ranking.player_id] %>
          <%= render PlayerCardComponent.new(ranking: ranking, player: player, facts: @row_facts&.dig(player.id)) %>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-8 text-center">
        <div class="text-zinc-500">
          <svg class="mx-auto h-12 w-12 text-zinc-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
            <path d="M34 40h10v-4a6 6 0 00-10.712-3.714M34 40H14m20 0v-4a9.971 9.971 0 00-.712-3.714M14 40H4v-4a6 6 0 0110.713-3.714M14 40v-4c0-1.313.253-2.566.713-3.714m0 0A9.971 9.971 0 0124 24c4.004 0 7.625 2.31 9.287 5.286" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <h3 class="mt-2 text-sm font-medium text-zinc-900">No rankings yet</h3>
          <p class="mt-1 text-sm text-zinc-500">
            No ranking data available for <%= horizon_label.downcase %><%= " (#{@position_filter.capitalize}s)" if @position_filter.present? %>.
          </p>
        </div>
      </div>
    <% end %>

    <%= render "players/seo_content" %>
<% end %>
