<% content_for :meta_title, "#{@player.full_name} - Fantasy Forecast" %>
<% content_for :meta_description, "#{@player.full_name} fantasy football stats, rankings, and news. Get the latest forecast and performance data for your FPL decisions." %>
<% content_for :head do %>
  <%= player_structured_data(@player) %>
<% end %>

<!-- Back Link -->
<%= link_to root_path(position: @player.position), class: "inline-flex items-center gap-1 text-sm text-zinc-500 hover:text-zinc-950" do %>
  <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
  </svg>
  Back to Rankings
<% end %>

<!-- Player Banner -->
<div class="mt-6">
  <h1 class="sr-only"><%= @player.full_name %></h1>

  <% if @player_ranking %>
    <%= render PlayerCardComponent.new(ranking: @player_ranking, player: @player, facts: @player_facts, show_position: true, hero: true) %>
  <% else %>
    <div class="flex items-start gap-6">
      <%= render PlayerAvatarComponent.new(player: @player, size: :large) %>
      <div class="flex-1">
        <p class="text-2xl font-semibold text-zinc-950"><%= @player.full_name %></p>
        <div class="text-sm text-zinc-500 mt-1">
          <p class="flex items-center gap-1.5">
            <%= render TeamBadgeComponent.new(team: @player.team, size: 16) %>
            <%= @player.team&.name %>
          </p>
          <p class="mt-1"><%= @player.position.capitalize %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @player.news.present? %>
    <div class="mt-3 rounded-lg bg-red-400/10 px-3 py-2">
      <p class="text-sm text-red-700"><%= @player.news %></p>
    </div>
  <% end %>
</div>

<!-- Top Section: Fixture & Form -->
<div class="mt-8 flex flex-wrap items-start gap-8">
  <% if @upcoming_matches&.any? %>
    <div>
      <h2 class="text-base/6 font-semibold text-zinc-950"><%= @upcoming_matches.size > 1 ? "Next Fixtures" : "Next Fixture" %></h2>
      <div class="mt-4 flex flex-col gap-2">
        <% @upcoming_matches.each do |match| %>
          <%= render FixtureComponent.new(match: match, player: @player) %>
        <% end %>
      </div>
    </div>
  <% end %>

  <div>
    <h2 class="text-base/6 font-semibold text-zinc-950">Recent Form</h2>
    <% if @performances.any? %>
      <div class="mt-4">
        <%= render FormComponent.new(scores: @form_scores) %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-zinc-500">No performance data available yet.</p>
    <% end %>
  </div>
</div>

<!-- Forecast -->
<div class="mt-8">
  <h2 class="text-base/6 font-semibold text-zinc-950">Forecast</h2>
  <% if @forecast %>
    <div class="mt-4 rounded-lg bg-zinc-100 p-4">
      <div class="flex items-center gap-3">
        <span class="text-4xl font-extrabold tracking-[-0.03em] leading-none text-zinc-900"><%= @forecast[:grade] %></span>
        <div class="text-sm text-zinc-600">
          <% if @forecast[:rank] %>
            <p class="font-medium text-zinc-950">#<%= @forecast[:rank] %> <%= @player.position.capitalize %></p>
          <% end %>
          <% if @forecast[:score] %>
            <p><%= format("%.2f", @forecast[:score]) %> expected points</p>
          <% end %>
        </div>
      </div>

      <% drivers = forecast_drivers(@forecast[:working]) %>
      <% opponents = @forecast.dig(:working, "opponents") %>
      <% if drivers.any? || opponents.present? %>
        <dl class="mt-4 space-y-3 border-t border-zinc-200 pt-4 text-sm">
          <% drivers.each do |d| %>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-zinc-950 font-medium">
                <%= d[:label] %>
                <span class="block text-xs font-normal text-zinc-500"><%= d[:note] %></span>
              </dt>
              <dd class="tabular-nums text-zinc-700 whitespace-nowrap"><%= d[:value] %></dd>
            </div>
          <% end %>
          <% if opponents.present? %>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-zinc-950 font-medium">
                Fixtures
                <span class="block text-xs font-normal text-zinc-500">each game weighed by difficulty</span>
              </dt>
              <dd class="text-zinc-700 text-right">
                <% opponents.each do |o| %>
                  <span class="block whitespace-nowrap"><%= o["name"] %> (<%= o["home"] ? "H" : "A" %><%= ", FDR #{o['difficulty']}" if o["difficulty"].to_i.positive? %>)</span>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-sm text-zinc-500">No forecast available.</p>
  <% end %>
</div>
