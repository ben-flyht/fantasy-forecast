<% content_for :meta_title, player_meta_title(@player, @forecast) %>
<% content_for :meta_description, player_meta_description(@player, @forecast, @player_facts) %>
<% content_for :meta_image, "#{ApplicationHelper::BASE_URL}#{@card_path}" %>
<% content_for :head do %>
  <%= player_structured_data(@player) %>
<% end %>

<%# His name was sr-only, so the one page a stranger arrives at by searching a
    player's name had no visible heading on it. %>
<%= render PageHeadingComponent.new(
      title: @player.full_name,
      subtitle: [ @player.position.capitalize, @player.team&.name ].compact.join(", "),
      updated_at: @forecast_at,
      share: "Share #{@player.display_name}'s forecast",
      back: back_to("Rankings", rankings_path(position: @player.position)),
      horizons: (forecast_horizons(gameweek: @next_gameweek&.fpl_id, current: @horizon,
                                   urls: { gameweek: player_path(@player),
                                           upcoming: player_path(@player, horizon: "upcoming"),
                                           season: player_path(@player, horizon: "season") }) if @forecast)) %>

<!-- Player Banner -->
<div class="mt-group">
  <% if @player_ranking %>
    <%= render PlayerHeroComponent.new(player: @player, facts: @player_facts, duties: @profile.set_pieces) %>
  <% else %>
    <div class="flex items-start gap-6">
      <%= render PlayerAvatarComponent.new(player: @player, size: :large) %>
      <div class="flex-1">
        <p class="text-title text-ink"><%= @player.full_name %></p>
        <div class="text-sm text-muted mt-1">
          <p class="flex items-center gap-1.5">
            <%= render TeamBadgeComponent.new(team: @player.team, size: 16) %>
            <%= @player.team&.name %>
          </p>
          <p class="mt-1"><%= @player.position.capitalize %></p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @player.news.present? %>
    <%= render NoticeComponent.new(message: @player.news, class: "mt-3") %>
  <% end %>
</div>

<!-- Why this grade -->
<%# The horizon toggle lives in the heading, so the whole page navigates rather
    than the panel alone. Turbo Drive still swaps the body without a reload. %>
<% if @forecast %>
  <% reach = Horizon.find(@forecast[:horizon]) %>
  <%= render PanelComponent.new(class: "mt-4") do %>
    <dl class="flex flex-wrap items-baseline gap-x-6 gap-y-4 lg:gap-x-10">
      <% if @forecast[:rank] %>
        <%= render StatComponent.new(label: "Rank", value: "##{@forecast[:rank]}", size: :xl) do %>
          <%= render RankMovementComponent.new(history: @history) %>
        <% end %>
      <% end %>
      <% if @forecast[:grade] %>
        <%= render StatComponent.new(label: "Grade", value: @forecast[:grade], size: :xl) %>
      <% end %>
      <% if @forecast[:score] %>
        <%= render StatComponent.new(label: "Expected points for #{reach.span}", value: format("%.1f", @forecast[:score]), size: :xl) %>
      <% end %>
    </dl>

    <% if @forecast[:tier] %>
      <p class="mt-5 text-sm font-medium text-body"><%= TierCalculator::TIERS.dig(@forecast[:tier], :description) %></p>
    <% end %>

    <%# The one figure on the page a reader can mark ours against for free. FPL
        publishes it for the coming week only, so the other horizons say nothing. %>
    <% if @forecast[:horizon] == "gameweek" && (verdict = against_fpl(@forecast[:score], @player_facts&.dig(PlayersController::FPL_EXPECTED_POINTS))) %>
      <p class="mt-1 text-sm text-body"><%= verdict %></p>
    <% end %>

    <%# The arithmetic that produced the figures above, in the same panel as
        them: the number and its reasons are one thought, not two. %>
    <%= render ForecastWorkingComponent.new(working: @working, horizon: @horizon,
                                            position: @player.position, chance: @profile.chance_of_playing) %>

    <%# What else the money buys, beside what he is worth: one decision, one panel. %>
    <%= render AlternativesComponent.new(comparison: @comparison, player: @player, horizon: @horizon) %>
  <% end %>
<% end %>

<!-- Who is in his way for a place in the side -->
<%= render PlayerOptionsComponent.new(
      entries: @comparison.rivals, horizon: @horizon,
      cost: @comparison.cost, score: @forecast&.dig(:score)&.to_f,
      title: "Competing for a start",
      subtitle: "Every #{@player.position} at #{@player.team&.name}, best forecast first." ) %>

<%# The players he is genuinely being chosen among, each with a page that answers
    the pair outright. %>
<% if @related&.any? %>
  <section class="mt-section">
    <%= render SectionHeadingComponent.new(
          title: "Him or him?",
          subtitle: "The players our forecast puts next to him, answered one pair at a time.") %>
    <div class="mt-stack">
      <%= render ChipLinksComponent.new(links: comparison_links(@related)) %>
    </div>
  </section>
<% end %>

<!-- Form & Fixtures -->
<div class="mt-section grid gap-8 md:grid-cols-2">
  <%= render FormStripComponent.new(
        title: "Recent Form",
        rows: @recent_rows || [],
        empty_message: "No matches played yet this season.") %>

  <%= render FixtureTableComponent.new(
        title: "Next #{(@upcoming_rows&.size).to_i} #{'Fixture'.pluralize((@upcoming_rows&.size).to_i)}",
        rows: @upcoming_rows || [],
        points_label: "xP",
        empty_message: "No upcoming fixtures scheduled.") %>
</div>

<!-- What he has actually done, and which way the rates are moving -->
<%= render SeasonRecordComponent.new(history: @history) %>

<%# And the season before it, which in August is nearly all the evidence there is. %>
<%= render LastSeasonComponent.new(stats: @last_season, position: @player.position) %>
