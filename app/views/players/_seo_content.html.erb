<% if @consensus_rankings.any? %>
  <% grade_a = @consensus_rankings.select { |r| r.tier == 1 && r.bot_rank.present? } %>
  <% grade_b = @consensus_rankings.select { |r| r.tier == 2 && r.bot_rank.present? } %>

  <div class="mt-8 space-y-6 text-sm text-zinc-600">
    <div>
      <h2 class="text-lg font-semibold text-zinc-900">FPL <%= @position_filter.capitalize %> Rankings — <%= horizon_label %></h2>
      <p class="mt-2">
        Our algorithm ranks every Premier League <%= @position_filter %> for <%= horizon_label %> by starting from the market — each player's price and ownership — and weighing it against recent form, upcoming fixtures, and expected goals.
        Players are graded from A (must-start picks) down to D (marginal). Anyone we would avoid is left ungraded.
      </p>
    </div>

    <% if grade_a.any? %>
      <div>
        <h3 class="font-semibold text-zinc-900">Grade A — Top <%= @position_filter.capitalize %> Picks for <%= horizon_short %></h3>
        <ul class="mt-2 space-y-2">
          <% grade_a.first(5).each do |r| %>
            <% player = @players_by_id[r.player_id] %>
            <% next unless player %>
            <% fixtures = (@matches_by_team[player.team_id] || []).map { |m|
                 opponent = m.home_team_id == player.team_id ? m.away_team.name : m.home_team.name
                 venue = m.home_team_id == player.team_id ? "home" : "away"
                 "#{opponent} (#{venue})"
               } %>
            <li>
              <%= link_to player.display_name, player_path(player), class: "font-semibold text-zinc-900 hover:underline" %>
              (<%= player.team&.name %><%= " vs #{fixtures.join(', ')}" if fixtures.any? %>)
            </li>
          <% end %>
        </ul>
        <p class="mt-2">
          These <%= @position_filter %>s have the strongest combination of market backing, form, fixtures, and underlying stats heading into <%= horizon_label %>.
        </p>
      </div>
    <% end %>

    <% if grade_b.any? %>
      <div>
        <h3 class="font-semibold text-zinc-900">Grade B — Strong <%= @position_filter.capitalize %> Alternatives for <%= horizon_short %></h3>
        <ul class="mt-2 space-y-2">
          <% grade_b.first(5).each do |r| %>
            <% player = @players_by_id[r.player_id] %>
            <% next unless player %>
            <% fixtures = (@matches_by_team[player.team_id] || []).map { |m|
                 opponent = m.home_team_id == player.team_id ? m.away_team.name : m.home_team.name
                 venue = m.home_team_id == player.team_id ? "home" : "away"
                 "#{opponent} (#{venue})"
               } %>
            <li>
              <%= link_to player.display_name, player_path(player), class: "font-semibold text-zinc-900 hover:underline" %>
              (<%= player.team&.name %><%= " vs #{fixtures.join(', ')}" if fixtures.any? %>)
            </li>
          <% end %>
        </ul>
        <p class="mt-2">
          These <%= @position_filter %>s offer reliable upside just behind the must-start picks for <%= horizon_label %>.
        </p>
      </div>
    <% end %>

    <div>
      <h3 class="font-semibold text-zinc-900">How Our FPL <%= @position_filter.capitalize %> Rankings Work</h3>
      <p class="mt-1">
        Fantasy Forecast uses a data-driven algorithm that lets the market lead — a player's price and how many managers own him — and weighs it against recent performance, expected goals and assists, minutes security, and fixture difficulty to produce weekly rankings for every Premier League position.
        Rankings update automatically each gameweek and are designed to help FPL managers make informed captain, transfer, and starting XI decisions.
      </p>
    </div>

    <div>
      <h3 class="font-semibold text-zinc-900">Grade System</h3>
      <ul class="mt-1 space-y-1">
        <% TierCalculator::TIERS.each do |tier, info| %>
          <li><span class="font-semibold text-zinc-900"><%= TierCalculator::GRADE_LETTERS.fetch(tier, TierCalculator::UNGRADED) %></span> — <%= info[:description] %></li>
        <% end %>
      </ul>
    </div>

    <div>
      <h3 class="font-semibold text-zinc-900">FPL <%= @position_filter.capitalize %> FAQ</h3>
      <dl class="mt-2 space-y-3">
        <div>
          <dt class="font-medium text-zinc-900">Who are the best FPL <%= @position_filter %>s for <%= horizon_label %>?</dt>
          <dd class="mt-1">
            <% if grade_a.any? %>
              Our top-rated <%= @position_filter %>s for <%= horizon_short %> are
              <%= grade_a.first(3).map { |r| "#{r.name} (#{@players_by_id[r.player_id]&.team&.short_name})" }.join(", ") %>.
              These players have the strongest market backing alongside recent form and favourable fixtures.
            <% else %>
              Check the rankings table above for the latest picks — rankings update automatically based on the market, form, and fixtures.
            <% end %>
          </dd>
        </div>
        <div>
          <dt class="font-medium text-zinc-900">How often do FPL <%= @position_filter %> rankings update?</dt>
          <dd class="mt-1">Rankings update automatically every hour, incorporating the latest player statistics, fixture data, and team news from the Premier League.</dd>
        </div>
        <div>
          <dt class="font-medium text-zinc-900">What data is used to rank FPL <%= @position_filter %>s?</dt>
          <dd class="mt-1">Our algorithm analyses recent performance metrics (points, goals, assists, clean sheets, expected goals), upcoming fixture difficulty, and how many managers are backing each player, to produce an expected points score.</dd>
        </div>
      </dl>
    </div>

    <% other_positions = %w[goalkeeper defender midfielder forward].reject { |p| p == @position_filter } %>
    <div>
      <h3 class="font-semibold text-zinc-900">More FPL Rankings</h3>
      <p class="mt-1">
        Browse rankings for other positions:
        <% other_positions.each_with_index do |pos, i| %>
          <%= link_to "#{pos.capitalize}s",
              position_rankings_path(horizon_param, pos),
              class: "text-blue-600 hover:underline",
              data: { turbo_frame: "_top" } %><%= i == other_positions.size - 1 ? "." : "," %>
        <% end %>
      </p>
    </div>
  </div>
<% end %>
