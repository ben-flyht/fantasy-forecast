<% content_for :meta_title, "Check Your Email | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <%= render CalloutComponent.new(eyebrow: "Check your inbox", title: "Your pack is on its way.", tone: :dark,
                                  data: { pack_sent: true }) do %>
    <p>
      We've sent a link to <strong class="text-white"><%= @user.email %></strong>. Open it on the device you want to play on. It works once, within an hour.
    </p>
  <% end %>
</div>
