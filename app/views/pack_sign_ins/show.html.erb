<% content_for :meta_title, "Sign In | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <%= render CalloutComponent.new(eyebrow: "Signing in as #{@user.email}", title: "Your pack is ready.", tone: :dark,
                                  data: { pack_confirm_sign_in: true }) do %>
    <p>This keeps you signed in on this device.</p>
    <%= form_with url: pack_sign_in_path(token: params[:token]), method: :post, class: "mt-5", data: { turbo: false } do %>
      <%= render ButtonComponent.new(label: "Sign in and play", variant: :inverse, size: :md, type: "submit") %>
    <% end %>
  <% end %>
</div>
