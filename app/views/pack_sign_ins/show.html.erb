<% content_for :meta_title, "Sign In | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <%= form_with url: pack_sign_in_path(token: params[:token]), method: :post, class: "rounded-2xl bg-zinc-950 p-6 text-white", data: { turbo: false, pack_confirm_sign_in: true } do %>
    <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Signing in as <%= @user.email %></p>
    <p class="mt-2 text-2xl font-extrabold tracking-[-0.02em]">Your pack is ready.</p>
    <p class="mt-3 text-sm/6 text-zinc-300">This keeps you signed in on this device.</p>
    <%= submit_tag "Sign in and play", class: "mt-5 rounded-xl bg-white px-5 py-3 text-sm font-extrabold uppercase text-zinc-950 cursor-pointer" %>
  <% end %>
</div>
