<% content_for :meta_title, "This Week's Pack | Fantasy Forecast" %>
<% content_for :meta_robots, "noindex, nofollow" %>

<div class="mx-auto max-w-xl">
  <div class="mb-6">
    <%= render PageHeadingComponent.new(
          title: @gameweek ? "The Gameweek #{@gameweek.fpl_id} Pack" : "The Weekly Pack",
          subtitle: "One pack a week, the same for everyone. Seven pairs from neighbouring places in our rankings, one of them shiny. Pick your five, lock them in, and see who beats the forecast.") %>
  </div>

  <% if current_manager && @gameweek.nil? %>
    <div class="rounded-xl border border-zinc-200 px-6 py-10 text-center text-sm text-zinc-500">
      There is no gameweek coming up to open a pack for. <%= link_to "See your packs", my_packs_path, class: "font-bold text-zinc-950 underline underline-offset-2" %>.
    </div>
  <% elsif current_manager %>
    <div class="rounded-2xl bg-zinc-950 p-6 text-white">
      <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-400">Signed in as <%= current_manager.nickname %></p>
      <p class="mt-2 text-2xl font-extrabold tracking-[-0.02em]"><%= @entry ? "Your team is locked in." : "Your pack is waiting." %></p>
      <div class="mt-5 flex flex-wrap items-center gap-4">
        <%= link_to (@entry ? "See my team" : "Open my pack"), weekly_pack_path(gameweek: @gameweek.fpl_id),
              class: "rounded-xl bg-white px-5 py-3 text-sm font-extrabold uppercase text-zinc-950" %>
        <%= link_to "Leaderboard", pack_leaderboard_path(gameweek: @gameweek.fpl_id), class: "text-sm font-bold underline underline-offset-2" %>
        <%= link_to "My packs", my_packs_path, class: "text-sm font-bold underline underline-offset-2" %>
      </div>
    </div>
    <p class="mt-4 text-xs text-zinc-500">
      Not <%= current_manager.nickname %>? <%= button_to "Sign out", pack_sign_out_path, method: :delete, form_class: "inline", class: "underline underline-offset-2 cursor-pointer" %>
    </p>
  <% else %>
    <%= form_with url: pack_sign_ins_path, class: "rounded-2xl border border-zinc-200 p-6", data: { turbo: false } do |form| %>
      <% if @manager.errors.any? %>
        <p class="mb-4 rounded-lg bg-red-400/20 px-4 py-3 text-sm text-red-700"><%= @manager.errors.full_messages.to_sentence %></p>
      <% end %>
      <div class="space-y-4">
        <div>
          <%= form.label :email, "Your email", class: "block text-xs font-bold uppercase tracking-wider text-zinc-500" %>
          <%= form.email_field :email, value: @manager.email, required: true, autocomplete: "email",
                class: "mt-1 block w-full rounded-lg border border-zinc-300 px-3 py-2.5 text-base" %>
        </div>
        <div>
          <%= form.label :nickname, "Name on the leaderboard", class: "block text-xs font-bold uppercase tracking-wider text-zinc-500" %>
          <p class="mt-0.5 text-xs text-zinc-500">Only needed the first time you join.</p>
          <%= form.text_field :nickname, value: @manager.nickname, maxlength: Manager::NICKNAME_LENGTH, autocomplete: "nickname",
                class: "mt-1 block w-full rounded-lg border border-zinc-300 px-3 py-2.5 text-base" %>
        </div>
      </div>
      <%= form.button class: "pack-another mt-6 cursor-pointer" do %>
        <span class="pack-another__pack" aria-hidden="true"></span>
        <span>Sign in or join</span>
      <% end %>
      <p class="mt-4 text-xs/5 text-zinc-500">
        We email you a link that signs you in, and you stay signed in on that device. No password. Your email is only used to send you your pack and is never shown to anyone;
        the leaderboard shows the name you choose.
      </p>
    <% end %>
  <% end %>

  <p class="mt-8 text-xs">
    <%= link_to "Or play a practice pack, no email needed", new_pack_path, class: "font-medium text-zinc-500 underline underline-offset-2" %>
  </p>
</div>
