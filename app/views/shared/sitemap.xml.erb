<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Homepage -->
  <url>
    <loc><%= @base_url %>/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- The rankings in full, every position at once -->
  <url>
    <loc><%= @base_url %><%= rankings_path %></loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- The armband: one decision, one address, answered every week -->
  <url>
    <loc><%= @base_url %><%= captain_path %></loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>

  <!-- The best fifteen the budget buys, both horizons -->
  <url>
    <loc><%= @base_url %><%= squad_path %></loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc><%= @base_url %><%= season_squad_path %></loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Season Rankings Pages: the one ranking URL that is good all year -->
  <% %w[forwards midfielders defenders goalkeepers].each do |position| %>
  <url>
    <loc><%= @base_url %><%= season_position_path(position: position) %></loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <% end %>

  <!-- The coming gameweek, and only that one: a week already played is history
       rather than a page anyone is searching for, and offering all thirty-eight
       spends the crawler on near-copies of each other instead of on the season
       pages and the players. -->
  <% if @next_gameweek %>
    <% %w[forwards midfielders defenders goalkeepers].each do |position| %>
  <url>
    <loc><%= @base_url %><%= gameweek_position_path(gameweek: @next_gameweek, position: position) %></loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
    <% end %>
  <% end %>

  <!-- Comparisons. Every pair of players has an address and every one of them is
       a page, which is far more addresses than a sitemap may carry, so what is
       offered here is the arguments worth having: players our own forecast puts
       next to each other. The rest are found the way a reader finds them, by
       following the links on these. -->
  <url>
    <loc><%= @base_url %><%= comparisons_path %></loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  <% @comparisons.each do |pair| %>
  <url>
    <loc><%= @base_url %><%= comparison_path(pair: pair.slug) %></loc>
    <changefreq>daily</changefreq>
    <priority>0.6</priority>
  </url>
  <% end %>

  <!-- Player Pages (grouped by position) -->
  <% %w[forward midfielder defender goalkeeper].each do |position| %>
    <% @players_by_position[position]&.each do |player| %>
  <url>
    <loc><%= @base_url %><%= player_path(player) %></loc>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
    <% end %>
  <% end %>

  <!-- Static Pages -->
  <url>
    <loc><%= @base_url %><%= contact_us_path %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.4</priority>
  </url>
  <url>
    <loc><%= @base_url %><%= privacy_policy_path %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc><%= @base_url %><%= terms_of_service_path %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc><%= @base_url %><%= cookie_policy_path %></loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
