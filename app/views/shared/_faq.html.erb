<%#
  The questions a page answers, printed for a reader and then said again as schema
  for a crawler. One partial so the two can never drift apart: a schema claiming an
  answer the reader cannot see is the one thing Google treats as a lie.

  Pairs are [question, answer]. An answer may carry markup; the schema is given the
  words with the markup stripped out.
%>
<section class="mt-10">
  <h2 class="text-lg font-semibold text-zinc-900"><%= title %></h2>
  <dl class="mt-3 space-y-4">
    <% pairs.each do |question, answer| %>
      <div>
        <dt class="text-sm font-medium text-zinc-900"><%= question %></dt>
        <dd class="mt-1 max-w-2xl text-sm/6 text-zinc-600"><%= answer %></dd>
      </div>
    <% end %>
  </dl>
</section>

<% content_for :head do %><%= faq_structured_data(pairs) %><% end %>
