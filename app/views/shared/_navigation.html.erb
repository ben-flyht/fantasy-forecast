<%#
  The three things this site does, in a row where there is room for one and behind a
  button where there is not. Written once and rendered twice rather than duplicated,
  because a link that appears in one place and not the other is how a page ends up
  unreachable on a phone.
%>
<nav class="border-b border-zinc-950/10" data-controller="navigation"
     data-action="keydown.esc@window->navigation#close click@window->navigation#closeOnOutsideClick">
  <div class="container mx-auto flex items-center justify-between gap-4 px-4 py-4">
    <%= link_to root_path, "aria-label": "Fantasy Forecast", class: "inline-block" do %>
      <%= render "shared/logo" %>
    <% end %>

    <div class="hidden items-center gap-1 text-sm font-medium sm:flex">
      <%= render "shared/navigation_links", style: "rounded-lg px-3 py-1.5", resting: "text-zinc-500 hover:text-zinc-900" %>
    </div>

    <button type="button" data-navigation-target="button" data-action="navigation#toggle"
            class="-mr-2 inline-flex items-center justify-center rounded-lg p-2 text-zinc-500 hover:text-zinc-950 sm:hidden"
            aria-expanded="false" aria-controls="navigation-menu" aria-label="Menu">
      <svg class="size-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"/>
      </svg>
    </button>
  </div>

  <div id="navigation-menu" data-navigation-target="menu" class="hidden border-t border-zinc-950/10 sm:hidden">
    <div class="container mx-auto flex flex-col gap-1 px-4 py-3 text-sm font-medium">
      <%= render "shared/navigation_links", style: "rounded-lg px-3 py-2", resting: "text-zinc-600 hover:bg-zinc-100" %>
    </div>
  </div>
</nav>
