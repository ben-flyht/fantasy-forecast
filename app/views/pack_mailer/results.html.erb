<div style="font-family: Inter, Helvetica, Arial, sans-serif; max-width: 480px; margin: 0 auto; color: #09090b;">
  <p style="font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #71717a;">Gameweek <%= @gameweek.fpl_id %> pack · final</p>
  <h1 style="font-size: 40px; font-weight: 800; letter-spacing: -0.03em; margin: 8px 0 4px;"><%= @entry.real_points %> points</h1>
  <p style="font-size: 15px; line-height: 1.6; margin: 0 0 20px;">
    <%= @standing[:place].ordinalize %> of <%= @standing[:of] %>, <%= @manager.nickname %>.
  </p>
  <table style="width: 100%; border-collapse: collapse; font-size: 15px;">
    <tr>
      <td style="padding: 10px 0; border-top: 1px solid #e4e4e7;">Your accuracy</td>
      <td style="padding: 10px 0; border-top: 1px solid #e4e4e7; text-align: right; font-weight: 800;"><%= (@entry.accuracy * 100).round %>%</td>
    </tr>
    <tr>
      <td style="padding: 10px 0; border-top: 1px solid #e4e4e7;">The forecast's accuracy</td>
      <td style="padding: 10px 0; border-top: 1px solid #e4e4e7; text-align: right; font-weight: 800;"><%= (@entry.forecast_accuracy * 100).round %>%</td>
    </tr>
  </table>
  <p style="font-size: 13px; line-height: 1.6; color: #71717a;">Accuracy is your points as a share of the best five this pack could have given, knowing what we know now.</p>
  <p style="margin: 24px 0 8px;">
    <a href="<%= pack_leaderboard_url(gameweek: @gameweek.fpl_id) %>" style="font-weight: 800; color: #09090b;">See the full leaderboard</a>
  </p>
  <% if @next_link %>
    <p style="margin: 24px 0;">
      <a href="<%= @next_link %>" style="display: inline-block; background: #09090b; color: #ffffff; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; text-decoration: none; padding: 14px 22px; border-radius: 12px;">Open the Gameweek <%= @next_gameweek.fpl_id %> pack</a>
    </p>
  <% end %>
</div>
