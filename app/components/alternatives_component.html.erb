<div class="mt-group border-t border-line pt-5">
  <h2 class="eyebrow"><%= heading %></h2>
  <p class="mt-1.5 text-sm text-body">
    <%= subtitle %>
    <% if verdict %><span class="font-medium text-ink"><%= verdict %></span><% end %>
  </p>

  <div class="mt-4 grid gap-3 lg:grid-cols-3">
    <% alternatives.each do |entry| %>
      <%= render PlayerCardComponent.new(ranking: entry.ranking, player: entry.player, facts: entry.facts) %>
    <% end %>
  </div>
</div>
