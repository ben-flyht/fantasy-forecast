<section class="mt-8">
  <h2 class="text-base/6 font-semibold text-zinc-950">Last season</h2>
  <p class="mt-1 text-sm text-zinc-500">What he actually did, which is most of what a forecast in August is reading.</p>

  <dl class="mt-3 flex flex-wrap gap-x-10 gap-y-4 rounded-xl bg-zinc-50 px-5 py-4">
    <% totals.each do |label, value| %>
      <div>
        <dt class="text-[10px] font-bold uppercase tracking-wider text-zinc-500"><%= label %></dt>
        <dd class="mt-1 text-lg font-extrabold leading-none tracking-[-0.02em] tabular-nums text-zinc-950"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <% if rates.any? %>
    <ul class="mt-4 divide-y divide-zinc-100">
      <% rates.each do |label, value| %>
        <li class="flex items-center justify-between gap-4 py-2.5">
          <span class="text-sm text-zinc-600"><%= label %></span>
          <span class="text-sm font-semibold tabular-nums text-zinc-950"><%= value %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
