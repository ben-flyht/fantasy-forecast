<section class="mt-section">
  <%= render SectionHeadingComponent.new(title: title, subtitle: summary) %>

  <table class="data-table mt-stack">
    <thead>
      <tr>
        <th class="w-[10%]">#</th>
        <th class="w-[38%]">Player</th>
        <th class="w-[17%] text-right">Cost</th>
        <th class="w-[15%] text-right">Diff</th>
        <th class="w-[20%] text-right"><%= points_label %></th>
      </tr>
    </thead>
    <tbody>
      <% entries.each_with_index do |entry, index| %>
        <% if (skipped = skipped_before(entry, index)).positive? %>
          <tr class="text-faint">
            <td class="py-1 text-center tabular-nums" aria-hidden="true">&ctdot;</td>
            <td class="py-1 text-xs" colspan="4"><%= pluralize(skipped, "place") %> not shown</td>
          </tr>
        <% end %>
        <tr class="<%= "bg-surface-subtle font-semibold text-ink" if entry.subject? %>">
          <td class="tabular-nums text-faint"><%= entry.place %></td>
          <td class="truncate">
            <% if entry.subject? %>
              <%= entry.player.display_name %>
            <% else %>
              <%= link_to entry.player.display_name, player_path(entry.player), class: "hover:text-ink hover:underline" %>
            <% end %>
          </td>
          <td class="text-right tabular-nums"><%= helpers.player_price(entry.cost) || "—" %></td>
          <td class="text-right tabular-nums text-muted"><%= difference(entry) || "—" %></td>
          <td class="text-right tabular-nums font-semibold <%= better?(entry) ? "text-ink" : "text-faint" %>">
            <%= points(entry) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
