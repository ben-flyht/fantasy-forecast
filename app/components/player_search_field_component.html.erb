<div class="relative">
  <svg class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" d="M12 5v14M5 12h14"/>
  </svg>
  <input type="text" id="comparison-add-<%= side %>"
         data-comparison-builder-target="input" data-side="<%= side %>"
         data-action="input->comparison-builder#search keydown->comparison-builder#keydown"
         autocomplete="off" placeholder="Add a player"
         aria-label="<%= label %>"
         role="combobox" aria-autocomplete="list" aria-expanded="false"
         aria-controls="<%= results_id %>"
         class="w-full rounded-card border-2 border-dashed border-line-strong bg-surface-subtle py-3 pl-9 pr-3 text-sm font-medium text-body placeholder:text-muted hover:border-line-emphasis focus:border-solid focus:border-ink/40 focus:bg-surface focus:outline-none focus:ring-2 focus:ring-ink/10">
  <div class="absolute left-0 right-0 top-full z-20 mt-1 max-h-64 overflow-y-auto rounded-control border border-line bg-surface shadow-lg"
       id="<%= results_id %>"
       data-comparison-builder-target="results" data-side="<%= side %>" role="listbox" hidden></div>
</div>
