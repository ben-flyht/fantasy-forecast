<section class="mt-section">
  <%= render SectionHeadingComponent.new(title: title) %>
  <dl class="mt-3 space-y-4">
    <% pairs.each do |question, answer| %>
      <div>
        <dt class="text-sm font-medium text-ink"><%= question %></dt>
        <dd class="mt-1 max-w-2xl text-copy text-body"><%= answer %></dd>
      </div>
    <% end %>
  </dl>
</section>
