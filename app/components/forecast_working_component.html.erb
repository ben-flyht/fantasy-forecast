<div class="mt-group border-t border-line pt-5">
  <h2 class="eyebrow">How we got there</h2>

  <div class="mt-4 grid gap-x-10 gap-y-6 sm:grid-cols-2">
    <!-- What he is worth in a single game -->
    <div>
      <p class="text-sm font-semibold text-ink">
        Worth <span class="tabular-nums"><%= points(estimate) %></span> points a game
      </p>

      <% if estimates_differ? %>
        <dl class="mt-2 space-y-1 text-sm text-body">
          <div class="flex justify-between gap-4">
            <dt>What his record says</dt>
            <dd class="tabular-nums font-medium text-ink"><%= points(ours) %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt>What his price and ownership say</dt>
            <dd class="tabular-nums font-medium text-ink"><%= points(crowd) %></dd>
          </div>
        </dl>
        <% if record_swing %>
          <p class="mt-2 text-sm text-body">
            His record argues him <strong class="font-semibold text-ink"><%= percentage(record_swing) %></strong>
            against what the market pays for him.
          </p>
        <% end %>
      <% elsif both_estimates? %>
        <p class="mt-2 text-sm text-body">
          His record and his price say the same thing, so there is nothing to argue about.
        </p>
      <% elsif crowd.nil? %>
        <p class="mt-2 text-sm text-body">The market has no reading on him, so this is his record alone.</p>
      <% else %>
        <p class="mt-2 text-sm text-body">We have no record to read yet, so this is his price and ownership alone.</p>
      <% end %>

      <p class="mt-2 text-xs text-muted">
        <% if rate_worth_stating? %>
          Built from <span class="tabular-nums font-medium"><%= points(per_90) %></span> points per 90 minutes,
          over an expected <span class="tabular-nums font-medium"><%= minutes %></span> minutes a game.
        <% elsif plays_full_match? %>
          He is expected to play the full 90 minutes.
        <% elsif minutes&.positive? %>
          Over an expected <span class="tabular-nums font-medium"><%= minutes %></span> minutes a game.
        <% end %>
        <% if form_swing %>
          His recent form is <span class="tabular-nums font-medium"><%= percentage(form_swing) %></span> on his usual, already inside this rate.
        <% end %>
        <% if calibration_swing %>
          Trimmed <span class="tabular-nums font-medium"><%= percentage(calibration_swing) %></span>, because forecasts this high have run ahead of what players went on to score.
        <% end %>
      </p>
    </div>

    <!-- What the horizon does to it -->
    <div>
      <% if opponents.empty? %>
        <p class="text-sm font-semibold text-ink">No fixture, so nothing to score.</p>
      <% elsif season? %>
        <p class="text-sm font-semibold text-ink">
          <%= pluralize(opponents.size, "fixture") %> to come, worth
          <span class="tabular-nums">&times;<%= format("%.1f", games) %></span>
        </p>
        <% if average_difficulty %>
          <p class="mt-2 text-sm text-body">
            Averaging <span class="tabular-nums font-medium text-ink"><%= format("%.1f", average_difficulty) %></span>
            out of 5 for difficulty, each counted for what it is worth to him.
          </p>
        <% end %>
      <% elsif single_fixture %>
        <p class="text-sm font-semibold text-ink">
          <%= single_fixture[:name] %>
          <span class="font-normal text-muted">(<%= single_fixture[:home] ? "home" : "away" %>)</span>
        </p>
        <p class="mt-2 text-sm text-body">
          <% if single_fixture[:difficulty]&.positive? %>
            Rated <span class="tabular-nums font-medium text-ink"><%= single_fixture[:difficulty] %> out of 5</span> for difficulty<%= fixture_effect ? "," : ", which is an ordinary afternoon and leaves the estimate where it is." %>
          <% end %>
          <% if fixture_effect %>
            worth <strong class="font-semibold text-ink"><%= percentage(fixture_effect) %></strong> to a player like him.
          <% end %>
        </p>
      <% else %>
        <p class="text-sm font-semibold text-ink">
          <%= pluralize(opponents.size, "fixture") %> this gameweek, worth
          <span class="tabular-nums">&times;<%= format("%.2f", games) %></span>
        </p>
        <ul class="mt-2 space-y-1 text-sm">
          <% opponents.each do |opponent| %>
            <li class="flex justify-between gap-4 text-body">
              <span><%= opponent[:name] %> <span class="text-faint">(<%= opponent[:home] ? "H" : "A" %>)</span></span>
              <% if opponent[:difficulty]&.positive? %>
                <span class="tabular-nums text-muted">difficulty <%= opponent[:difficulty] %>/5</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if transfer_swing %>
        <p class="mt-2 text-sm text-body">
          Managers are
          <strong class="font-semibold text-ink"><%= transfer_swing > 1 ? "buying" : "selling" %></strong>
          him, worth <span class="tabular-nums font-medium text-ink"><%= percentage(transfer_swing) %></span>.
        </p>
      <% end %>
    </div>
  </div>

  <% if caveats.any? %>
    <p class="mt-4 text-xs text-muted"><%= caveats.join(" ") %></p>
  <% end %>
</div>
