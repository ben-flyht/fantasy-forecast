<%= content_tag tag_name, class: classes, style: style, data: data, **link_attributes do %>
  <div class="pack-card__space">
    <div class="pack-card__body">
      <div class="pack-card__face <%= ink_class %>">
        <div class="pack-card__club">
          <span class="pack-card__foil" aria-hidden="true">
            <span class="pack-card__glitter--shards"></span>
            <span class="pack-card__glitter--left"></span>
            <span class="pack-card__glitter--top"></span>
            <span class="pack-card__glitter--flecks-a"></span>
            <span class="pack-card__glitter--flecks-b"></span>
          </span>
          <% if player.cutout_url %>
            <%= image_tag player.cutout_url, alt: "", class: "pack-card__photo", onerror: "this.remove()" %>
          <% end %>
        </div>

        <% if team&.badge_url %>
          <%= image_tag team.badge_url, alt: team.name, class: "pack-card__badge" %>
        <% end %>
        <span class="pack-card__corner pack-card__corner--position"><%= position %></span>

        <div class="pack-card__banner">
          <% if player.given_name.present? %>
            <span class="pack-card__given"><%= player.given_name %></span>
          <% end %>
          <span class="<%= name_class %>"><%= player.display_name %></span>
          <span class="pack-card__team"><%= team&.short_name %> <span class="pack-card__fixture" data-pack-fixture><%= fixture %></span></span>
        </div>

        <% if captain? %>
          <span class="pack-card__captain" title="Captain">C</span>
        <% end %>

      </div>

      <div class="pack-card__back" aria-hidden="true">
        <%= render "shared/logo", size: "6.4cqw" %>
      </div>
    </div>
  </div>
<% end %>
