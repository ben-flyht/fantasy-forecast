<dl class="mt-4 flex flex-wrap gap-x-8 gap-y-4 rounded-xl bg-zinc-50 px-5 py-4">
  <% facts.each do |fact| %>
    <div>
      <dt class="text-[10px] font-bold uppercase tracking-wider text-zinc-500"><%= fact.label %></dt>
      <dd class="mt-1 text-sm <%= fact.notable? ? "font-semibold text-zinc-950" : "font-medium text-zinc-800" %>">
        <%= fact.value %>
      </dd>
    </div>
  <% end %>
</dl>
