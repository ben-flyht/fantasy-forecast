<div class="max-w-xs" data-controller="comparison-builder" data-comparison-builder-url-value="<%= comparison_search_path %>">
  <div data-comparison-builder-target="side" data-side="0">
    <div class="flex flex-col gap-2 empty:hidden" data-comparison-builder-target="chips"></div>
    <%= render PlayerSearchFieldComponent.new(side: 0) %>
  </div>
  <template data-comparison-builder-target="removeTemplate">
    <%= render "comparisons/remove_button", name: "player" %>
  </template>
</div>
