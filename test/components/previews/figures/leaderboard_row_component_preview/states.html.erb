<ol class="mx-auto max-w-xl divide-y divide-line rounded-card border border-line">
  <% rows.each do |row| %>
    <%= render LeaderboardRowComponent.new(**row) do |entry| %>
      <% entry.with_figures do %>
        <span class="w-14 text-right text-figure tabular-nums text-ink">42</span>
      <% end %>
    <% end %>
  <% end %>
</ol>
