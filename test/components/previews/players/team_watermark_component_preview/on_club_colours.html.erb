<div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
  <% teams.each do |team| %>
    <div class="relative h-32 overflow-hidden rounded-card" style="background-color: <%= team.color %>">
      <%= render TeamWatermarkComponent.new(team: team, class: "absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2") %>
    </div>
  <% end %>
</div>
